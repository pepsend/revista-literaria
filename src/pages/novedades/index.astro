---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { getOptimizedImageUrl } from '../../utils/images';

const items = (await getCollection('prensa')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Novedades & Prensa · ${SITE_TITLE}`} description="Lanzamientos editoriales, convocatorias literarias, ferias y noticias del circuito cultural." />
	</head>
	<body>
		<Header />
		<main class="listing at-container">
			<p class="at-kicker">prensa & actualidad</p>
			<h1 class="listing-title">novedades</h1>
			<p class="listing-lead">Lanzamientos editoriales, convocatorias literarias, ferias y noticias del circuito cultural independiente.</p>
			<hr class="at-rule" />

			{items.length === 0 && <p class="empty">sin novedades por el momento</p>}

			<div class="novedades-list">
				{items.map((item) => (
					<a class="novedad-entry" href={`/novedades/${item.id}/`}>
						{item.data.heroImage && (
							<img
								class="entry-thumb at-duotone"
								src={getOptimizedImageUrl(item.data.heroImage, { width: 200, height: 300, crop: 'fill', quality: 'auto:good' })}
								alt={item.data.title}
								loading="lazy"
								decoding="async"
								width="100"
								height="150"
								style={`object-position: ${item.data.imagePosition || 'center'};`}
							/>
						)}
						<div class="entry-content">
							<div class="entry-tag">{item.data.type || 'Novedad'}</div>
							<h2 class="entry-title">{item.data.title}</h2>
							{item.data.summary && <p class="entry-desc">{item.data.summary}</p>}
							<div class="entry-foot-mobile">
								{item.data.location && <span>{item.data.location}</span>}
								{item.data.eventDates && <span> · {item.data.eventDates}</span>}
							</div>
						</div>
						<div class="entry-meta">
							{item.data.location && <div>{item.data.location}</div>}
							{item.data.eventDates ? (
								<div>{item.data.eventDates}</div>
							) : (
								<FormattedDate date={item.data.date} />
							)}
						</div>
					</a>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.listing { padding: 2.5rem 1.5rem 5rem; }
	.listing-title {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: clamp(2.4rem, 6vw, 3.8rem);
		line-height: 0.95;
		letter-spacing: -0.02em;
		margin: 0.4rem 0 0.8rem;
		text-transform: lowercase;
	}
	.listing-lead {
		font-size: 0.9rem;
		color: var(--text-soft);
		max-width: 55ch;
		margin-bottom: 1.5rem;
		line-height: 1.5;
	}
	.empty {
		font-family: var(--font-mono);
		color: var(--muted);
		padding: 2rem 0;
	}
	.novedades-list {
		margin-top: 1rem;
	}
	.novedad-entry {
		display: grid;
		grid-template-columns: 100px 1fr auto;
		gap: 1.6rem;
		padding: 1.6rem 0;
		border-bottom: 1px solid var(--line);
		text-decoration: none;
		color: var(--ink);
		align-items: start;
		transition: background 0.15s;
	}
	.novedad-entry:hover {
		background: var(--paper-2);
	}
	.novedad-entry:hover .entry-title {
		color: var(--pink);
	}
	.entry-thumb {
		width: 100px;
		max-width: 100%;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border: 1.5px solid var(--ink);
		box-shadow: 2px 2px 0 var(--ink);
		background: var(--paper-2);
		display: block;
		flex-shrink: 0;
	}
	.entry-content {
		min-width: 0;
	}
	.entry-tag {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--pink);
		font-weight: 700;
		margin-bottom: 0.35rem;
	}
	.entry-title {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.35rem;
		line-height: 1.15;
		letter-spacing: -0.01em;
		margin-bottom: 0.45rem;
		transition: color 0.15s;
	}
	.entry-desc {
		font-size: 0.8rem;
		line-height: 1.5;
		color: var(--text-soft);
		max-width: 65ch;
	}
	.entry-foot-mobile {
		display: none;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--muted);
		margin-top: 0.5rem;
	}
	.entry-meta {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--muted);
		text-align: right;
		white-space: nowrap;
		padding-top: 0.2rem;
		line-height: 1.5;
	}

	@media (max-width: 720px) {
		.listing {
			padding: 1.8rem 1rem 3.5rem;
		}
		.listing-title {
			font-size: 1.9rem;
			margin-bottom: 0.4rem;
		}
		.listing-lead {
			font-size: 0.78rem;
			margin-bottom: 1rem;
		}
		.novedad-entry {
			grid-template-columns: 75px 1fr;
			gap: 0.85rem;
			padding: 1.1rem 0;
		}
		.entry-thumb {
			width: 75px;
			max-width: 75px;
			box-shadow: 2px 2px 0 var(--ink);
		}
		.entry-title {
			font-size: 0.95rem;
			line-height: 1.2;
			margin-bottom: 0.25rem;
		}
		.entry-desc {
			font-size: 0.72rem;
			line-height: 1.4;
		}
		.entry-meta {
			display: none;
		}
		.entry-foot-mobile {
			display: block;
		}
	}
</style>
