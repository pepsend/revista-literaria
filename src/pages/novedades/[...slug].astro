---
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { getOptimizedImageUrl } from '../../utils/images';

export async function getStaticPaths() {
	const items = await getCollection('prensa');
	return items.map((item) => ({
		params: { slug: item.id },
		props: { item },
	}));
}

const { item } = Astro.props;
const { Content } = await render(item);

const isBook = item.data.type?.toLowerCase() === 'lanzamiento';

// URL canónica del texto para los botones de compartir.
const shareUrl = new URL(Astro.url.pathname, Astro.site).href;
const waHref = `https://wa.me/?text=${encodeURIComponent(`${item.data.title} — ${shareUrl}`)}`;
const xHref = `https://twitter.com/intent/tweet?text=${encodeURIComponent(item.data.title)}&url=${encodeURIComponent(shareUrl)}`;

// Tarjeta vertical 9:16 para Instagram Stories (imagen + marca + título + URL)
const cldText = (s: string): string =>
	encodeURIComponent(s).replace(/%2C/g, '%252C').replace(/%2F/g, '%252F');

const buildStoryCard = (url: string, t: string, meta: string): string => {
	const enc = cldText(t);
	// 1. Barra superior sólida (#0e0e0e) de 130px: 'abulia terminal' centrado en y=55 sobre fondo oscuro propio, NUNCA sobre la imagen.
	const topBrandLayer =
		'co_rgb:ffffff,l_text:Georgia_34_bold:abulia%20terminal/g_north,y_55,fl_layer_apply/';
	// 2. Línea divisoria elegante justo donde termina la imagen (y=1130).
	const lineLayer =
		'b_rgb:3d3d3d,w_920,h_2,c_fill,l_text:arial_2:./g_north,y_1130,fl_layer_apply/';
	// 3. Título en bloque oscuro inferior, ordenado de arriba a abajo (g_north, y=1170) con tamaño equilibrado (48px) para que nunca invada la imagen hacia arriba.
	const titleLayer =
		'w_920,c_fit,co_rgb:ffffff,l_text:Georgia_48_bold:' + enc + '/g_north,y_1170,fl_layer_apply/';
	// 4. Metadatos (categoría / autor / editorial) en la parte inferior.
	const metaLayer = meta
		? 'co_rgb:d2c7b5,l_text:Georgia_34_bold:' + cldText(meta) + '/g_south,y_180,fl_layer_apply/'
		: '';
	// 5. Enlace al pie.
	const siteLayer =
		'co_rgb:8e8880,l_text:Georgia_26_bold:abuliaterminal.cl/g_south,y_110,fl_layer_apply';

	const layers = topBrandLayer + lineLayer + titleLayer + metaLayer + siteLayer;
	// La imagen se ajusta a 1080x1000 y se desplaza 130px hacia abajo (y_130) mediante c_pad sobre lienzo negro #0e0e0e de 1080x1920 (9:16).
	// De este modo, la imagen queda en su propia ventana limpia entre y=130 e y=1130, con CERO textos encima.
	const overlay =
		'w_1080,h_1000,c_fill,g_auto,f_jpg,q_auto:good/w_1080,h_1920,c_pad,g_north,y_130,b_rgb:0e0e0e/' +
		layers;

	const marker = '/image/upload/';
	const idx = url.indexOf(marker);
	if (idx !== -1 && url.includes('res.cloudinary.com')) {
		return `${url.slice(0, idx + marker.length)}${overlay}/${url.slice(idx + marker.length)}`;
	}
	const abs = url.startsWith('http') ? url : new URL(url, Astro.site).href;
	return `https://res.cloudinary.com/cs8tnt88/image/fetch/${overlay}/${abs}`;
};

const storyMeta = [item.data.type || 'Novedad', item.data.author || item.data.location].filter(Boolean).join(' · ');
const storyCard = item.data.heroImage ? buildStoryCard(item.data.heroImage, item.data.title, storyMeta) : null;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`${item.data.title} · Novedades · ${SITE_TITLE}`}
			description={item.data.summary || item.data.title}
			image={item.data.heroImage}
		/>
	</head>
	<body>
		<Header />

		<article class="art-wrap at-container">
			<nav class="art-back" aria-label="Volver">
				<a href="/novedades">← volver a novedades</a>
			</nav>

			<header class="art-head">
				<div class="art-kicker">novedades · {item.data.type || 'prensa'}</div>
				<h1 class="art-title">{item.data.title}</h1>

				<div class="art-meta-bar">
					{
						isBook ? (
							<>
								{item.data.location && (
									<div>
										editorial: <b>{item.data.location}</b>
									</div>
								)}
								{item.data.author && (
									<div>
										autora / autor: <b>{item.data.author}</b>
									</div>
								)}
							</>
						) : (
							<>
								{item.data.location && (
									<div>
										organización / lugar: <b>{item.data.location}</b>
									</div>
								)}
								{item.data.eventDates && (
									<div>
										fechas / plazos: <b>{item.data.eventDates}</b>
									</div>
								)}
							</>
						)
					}
					<div>
						publicado: <FormattedDate date={item.data.date} />
					</div>
				</div>
			</header>

			<div class="art-share">
				<span class="art-share-label">compartir</span>
				<div class="art-share-btns">
					<button
						class="share-btn share-btn--native"
						type="button"
						id="native-share"
						data-title={item.data.title}
						data-url={shareUrl}
						style="display: none;"
						aria-label="Compartir en tu dispositivo"
					>
						⤤ compartir
					</button>
					<a class="share-btn" href={waHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
					<a class="share-btn" href={xHref} target="_blank" rel="noopener noreferrer">X</a>
					{storyCard && (
						<button
							class="share-btn share-btn--story"
							type="button"
							id="share-story"
							data-story={storyCard}
							data-url={shareUrl}
						>
							Instagram
						</button>
					)}
					<button class="share-btn" type="button" id="copy-link" data-url={shareUrl}>
						copiar enlace
					</button>
				</div>
			</div>

			<div class="art-layout">
				{
					item.data.heroImage && (
						<aside class="art-aside">
							<div class="art-aside-card">
								<img
									class="art-aside-cover at-duotone"
									src={getOptimizedImageUrl(item.data.heroImage, { width: 400, height: 600, crop: 'fill', quality: 'auto:good' })}
									alt={item.data.title}
									loading="eager"
									decoding="async"
									width="220"
									height="330"
									style={`object-position: ${item.data.imagePosition || 'center'};`}
								/>
								<div class="art-aside-specs">
									{isBook ? (
										<>
											{item.data.author && (
												<p>
													<strong>autora / autor:</strong> {item.data.author}
												</p>
											)}
											{item.data.location && (
												<p>
													<strong>editorial:</strong> {item.data.location}
												</p>
											)}
										</>
									) : (
										<>
											{item.data.location && (
												<p>
													<strong>organiza / lugar:</strong> {item.data.location}
												</p>
											)}
											{item.data.eventDates && (
												<p>
													<strong>plazo / fecha:</strong> {item.data.eventDates}
												</p>
											)}
										</>
									)}
									{item.data.link && (
										<a
											class="art-aside-link"
											href={item.data.link}
											target="_blank"
											rel="noopener noreferrer"
										>
											{isBook ? 'sitio editorial / venta ↗' : 'más información / bases ↗'}
										</a>
									)}
								</div>
							</div>
						</aside>
					)
				}

				<div class="art-body">
					{item.data.summary && <div class="art-lead">{item.data.summary}</div>}
					<div class="art-markdown">
						<Content />
					</div>

					{
						(item.data.authorBio || item.data.authorImage) && (
							<aside class="art-author">
								<p class="art-author-label">{isBook ? 'sobre la autora' : 'nota biográfica'}</p>
								<div class="art-author-inner">
									{item.data.authorImage && (
										<img
											class="art-author-photo at-duotone"
											src={getOptimizedImageUrl(item.data.authorImage, { width: 200, height: 200, crop: 'fill', quality: 'auto:good' })}
											alt={item.data.author || 'Autora'}
											width="85"
											height="85"
										/>
									)}
									<div class="art-author-text">
										{item.data.author && <h3 class="art-author-name">{item.data.author}</h3>}
										{item.data.authorBio && (
											<div class="art-author-bio">
												<p>{item.data.authorBio}</p>
											</div>
										)}
									</div>
								</div>
							</aside>
						)
					}
				</div>
			</div>
		</article>

		<Footer />
		<script is:inline>
			(function () {
				// Copiar enlace
				var copyBtn = document.getElementById('copy-link');
				if (copyBtn) {
					copyBtn.addEventListener('click', function () {
						var url = copyBtn.getAttribute('data-url') || location.href;
						var done = function () {
							copyBtn.textContent = '¡copiado!';
							setTimeout(function () {
								copyBtn.textContent = 'copiar enlace';
							}, 1600);
						};
						if (navigator.clipboard && navigator.clipboard.writeText) {
							navigator.clipboard.writeText(url).then(done).catch(done);
						} else {
							var ta = document.createElement('textarea');
							ta.value = url;
							document.body.appendChild(ta);
							ta.select();
							try {
								document.execCommand('copy');
							} catch (e) {}
							document.body.removeChild(ta);
							done();
						}
					});
				}
				// Botón nativo de compartir para celulares (iOS Safari / Android Chrome)
				var nativeBtn = document.getElementById('native-share');
				if (nativeBtn && navigator.share) {
					nativeBtn.style.display = 'inline-flex';
					nativeBtn.addEventListener('click', function () {
						navigator.share({
							title: nativeBtn.getAttribute('data-title') || document.title,
							url: nativeBtn.getAttribute('data-url') || location.href,
						}).catch(function () {});
					});
				}
				// Compartir a Instagram (celular): imagen vertical 9:16
				var storyBtn = document.getElementById('share-story');
				if (storyBtn) {
					var storyImg = storyBtn.getAttribute('data-story');
					var storyFile = null;
					var isPrep = false;
					var prepStory = function () {
						if (!storyImg || storyFile || isPrep) return;
						isPrep = true;
						fetch(storyImg)
							.then(function (r) { return r.blob(); })
							.then(function (b) {
								storyFile = new File([b], 'abulia-terminal.jpg', {
									type: b.type || 'image/jpeg',
								});
							})
							.catch(function () {})
							.finally(function () { isPrep = false; });
					};
					storyBtn.addEventListener('mouseenter', prepStory, { passive: true });
					storyBtn.addEventListener('touchstart', prepStory, { passive: true });
					storyBtn.addEventListener('click', function () {
						if (storyFile && navigator.canShare && navigator.canShare({ files: [storyFile] })) {
							navigator.share({ files: [storyFile] }).catch(function () {});
							try {
								if (navigator.clipboard) navigator.clipboard.writeText(storyBtn.getAttribute('data-url') || '');
							} catch (e) {}
							return;
						}
						try {
							if (navigator.clipboard) navigator.clipboard.writeText(storyBtn.getAttribute('data-url') || '');
						} catch (e) {}
						if (storyImg) window.open(storyImg, '_blank');
					});
				}
			})();
		</script>
	</body>
</html>

<style>
	.art-wrap {
		max-width: 860px;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 5rem;
	}
	.art-back {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		margin-bottom: 1.5rem;
	}
	.art-back a {
		color: var(--muted);
		text-decoration: none;
		transition: color 0.15s;
	}
	.art-back a:hover {
		color: var(--pink);
		text-decoration: underline;
	}
	.art-kicker {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--pink);
		font-weight: 700;
		margin-bottom: 0.4rem;
	}
	.art-title {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: clamp(2rem, 5vw, 2.9rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
		margin-bottom: 1.2rem;
	}
	.art-meta-bar {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: var(--muted);
		border-top: 1px solid var(--ink);
		border-bottom: 1px solid var(--ink);
		padding: 0.6rem 0;
		margin-bottom: 2.2rem;
	}
	.art-meta-bar b {
		color: var(--ink);
	}
	/* Compartir */
	.art-share {
		margin: 0 0 2.2rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 0.7rem;
	}
	.art-share-label {
		font-family: var(--font-mono);
		font-size: 0.66rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--pink);
	}
	.art-share-btns {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.share-btn {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--ink);
		background: transparent;
		border: 1.5px solid var(--ink);
		padding: 0.3rem 0.6rem;
		text-decoration: none;
		cursor: pointer;
		min-height: 32px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		transition: background 0.15s ease, color 0.15s ease;
	}
	.share-btn--native {
		background: var(--pink);
		color: var(--ink);
		font-weight: 700;
	}
	.share-btn--native:hover {
		background: var(--ink);
		color: var(--paper);
	}
	.share-btn:hover {
		background: var(--ink);
		color: var(--paper);
	}
	.art-layout {
		display: grid;
		grid-template-columns: 220px 1fr;
		gap: 2.4rem;
		align-items: start;
	}
	.art-aside-card {
		border: 1.5px solid var(--ink);
		padding: 0.8rem;
		background: var(--paper-2);
		box-shadow: 3px 3px 0 var(--ink);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		line-height: 1.6;
	}
	.art-aside-cover {
		width: 100%;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border: 1px solid var(--ink);
		margin-bottom: 0.6rem;
		display: block;
	}
	.art-aside-specs p {
		margin: 0.2rem 0;
	}
	.art-aside-link {
		display: block;
		margin-top: 0.8rem;
		text-align: center;
		background: var(--ink);
		color: var(--paper);
		padding: 0.45rem;
		text-decoration: none;
		font-weight: 700;
		font-size: 0.7rem;
		transition: background 0.15s, color 0.15s;
	}
	.art-aside-link:hover {
		background: var(--pink);
		color: var(--ink);
	}
	.art-lead {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.15rem;
		line-height: 1.45;
		color: var(--ink);
		border-left: 3px solid var(--pink);
		padding-left: 1rem;
		margin-bottom: 1.8rem;
		font-style: italic;
	}
	.art-body {
		min-width: 0;
	}
	.art-markdown {
		font-family: var(--font-mono);
		font-size: 0.92rem;
		line-height: 1.75;
		color: var(--text);
	}
	.art-markdown :global(p) {
		margin-bottom: 1.3rem;
	}
	.art-markdown :global(h2),
	.art-markdown :global(h3) {
		font-family: var(--font-display);
		font-weight: 700;
		margin: 2rem 0 0.8rem;
		line-height: 1.2;
	}
	.art-markdown :global(blockquote) {
		border-left: 3px solid var(--pink);
		padding-left: 1.2rem;
		margin: 1.8rem 0;
		font-style: italic;
		font-family: var(--font-display);
		font-size: 1.15rem;
		line-height: 1.35;
	}
	.art-markdown :global(img) {
		border: 1.5px solid var(--ink);
		box-shadow: 3px 3px 0 var(--ink);
		max-width: 100%;
		height: auto;
		margin: 1.5rem 0;
	}

	.art-author {
		margin-top: 3rem;
		padding: 1.6rem 1.6rem 1.5rem;
		border: 2px solid var(--ink);
		background: var(--negro);
		color: var(--crema);
		box-shadow: 4px 4px 0 var(--ink);
	}
	.art-author-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--pink);
		margin: 0 0 0.8rem;
	}
	.art-author-inner {
		display: flex;
		gap: 1.2rem;
		align-items: flex-start;
	}
	.art-author-photo {
		width: 85px;
		height: 85px;
		object-fit: cover;
		border: 1.5px solid var(--crema);
		box-shadow: 2px 2px 0 var(--pink);
		flex-shrink: 0;
	}
	.art-author-text {
		min-width: 0;
	}
	.art-author-name {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: 1.25rem;
		margin: 0 0 0.4rem;
		color: var(--crema);
	}
	.art-author-bio {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 0.95rem;
		line-height: 1.55;
		color: #d8ccb6;
	}
	.art-author-bio p {
		margin: 0;
	}

	@media (max-width: 760px) {
		.art-wrap {
			padding: 1.8rem 1rem 3.5rem;
		}
		.art-title {
			font-size: 1.4rem;
			line-height: 1.2;
			margin-bottom: 0.8rem;
		}
		.art-layout {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
		.art-aside-card {
			max-width: 200px;
			margin: 0 auto 1rem;
		}
		.art-markdown {
			font-size: 0.84rem;
			line-height: 1.65;
		}
		.art-lead {
			font-size: 1rem;
			padding-left: 0.8rem;
			margin-bottom: 1.2rem;
		}
		.art-author-inner {
			flex-direction: column;
			gap: 0.8rem;
		}
		.art-author-photo {
			width: 75px;
			height: 75px;
		}
	}
</style>
