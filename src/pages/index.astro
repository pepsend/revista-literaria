---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Obtener todas las publicaciones ordenadas por fecha (más reciente primero)
const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Genera un extracto corto a partir del cuerpo del artículo
const excerpt = (body: string | undefined, length = 180) => {
	if (!body) return '';
	const text = body.replace(/[#*_>`\-]/g, '').replace(/\s+/g, ' ').trim();
	return text.length > length ? text.slice(0, length) + '…' : text;
};
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		
		<main class="container">
			<section class="hero">
				<h1 class="main-title">abulia terminal</h1>
				<p class="tagline">revista literaria: ensayo, crítica y creación</p>
			</section>

			<hr />

			<section class="feed">
				<h2 class="section-title">publicaciones recientes</h2>
				
				<div class="grid-posts">
					{
						posts.map((post) => (
							<article class="post-card">
								<span class="category">
									{post.data.category || 'publicación'}
								</span>
								<h3 class="post-title">
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								</h3>
								{post.data.author && (
									<p class="author">por {post.data.author}</p>
								)}
								<p class="excerpt">{excerpt(post.body)}</p>
							</article>
						))
					}
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(body) {
		background-color: #f5f0e6;
		color: #1a1918;
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
		margin: 0;
	}

	:global(header), 
	:global(footer), 
	.main-title, 
	.tagline, 
	.section-title, 
	.category, 
	.post-title {
		text-transform: lowercase;
	}

	.container {
		max-width: 800px;
		margin: 0 auto;
		padding: 2.5rem 1.5rem;
	}

	.hero-logo {
		width: 110px;
		height: auto;
		margin-bottom: 1rem;
		display: block;
	}

	.main-title {
		font-size: 2.2rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		margin: 0 0 0.4rem 0;
	}

	.tagline {
		font-size: 1rem;
		color: #666056;
		margin: 0;
	}

	hr {
		border: 0;
		border-top: 1px solid #e2dbce;
		margin: 2.5rem 0;
	}

	.section-title {
		font-size: 1rem;
		font-weight: 600;
		margin-bottom: 1.5rem;
		color: #e05a2b;
	}

	.grid-posts {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.post-card {
		border-bottom: 1px solid #e2dbce;
		padding-bottom: 1.5rem;
	}

	.category {
		font-size: 0.75rem;
		letter-spacing: 0.05em;
		color: #e6397d;
		font-weight: 600;
		display: block;
		margin-bottom: 0.3rem;
	}

	.post-title {
		margin: 0 0 0.5rem 0;
		font-size: 1.3rem;
		font-weight: 500;
	}

	.post-title a {
		color: #1a1918;
		text-decoration: none;
	}

	.post-title a:hover {
		color: #e6397d;
	}

	.author {
		font-size: 0.85rem;
		color: #666056;
		font-style: italic;
		margin: 0 0 0.5rem 0;
	}

	.excerpt {
		color: #4a453e;
		font-size: 0.95rem;
		line-height: 1.6;
		margin: 0;
	}
</style>