---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		
		<main class="container">
			<!-- Encabezado sobrio con el logo y presentación -->
			<section class="hero">
				<img src="/WhatsApp Image 2026-08-03 at 18.14.50.jpeg" alt="abulia terminal logo" class="hero-logo" />
				<h1 class="main-title">abulia terminal</h1>
				<p class="tagline">revista literaria: ensayo, crítica y creación</p>
			</section>

			<hr />

			<!-- Lista de publicaciones -->
			<section class="feed">
				<h2 class="section-title">publicaciones recientes</h2>
				
				<div class="grid-posts">
					<article class="post-card">
						<span class="category">ensayo</span>
						<h3 class="post-title"><a href="#">título de ensayo de prueba</a></h3>
						<p class="excerpt">Aquí va la bajada o extracto del texto en minúsculas para la vista previa de la portada...</p>
					</article>

					<article class="post-card">
						<span class="category">crítica</span>
						<h3 class="post-title"><a href="#">título de reseña o crítica de prueba</a></h3>
						<p class="excerpt">Anotaciones iniciales sobre la obra o fragmento destacado para los lectores...</p>
					</article>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(root) {
		--bg-color: #f5f0e6;
		--text-color: #1a1918;
		--accent-pink: #e6397d;
		--accent-orange: #e05a2b;
		--border-color: #e2dbce;
	}

	:global(body) {
		background-color: #f5f0e6;
		color: #1a1918;
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
		margin: 0;
	}

	/* Todo el sistema de interfaz en minúsculas */
	:global(header), 
	:global(footer), 
	.main-title, 
	.tagline, 
	.section-title, 
	.category, 
	.post-title {
		text-transform: lowercase;
	}

	.container {
		max-width: 800px;
		margin: 0 auto;
		padding: 2.5rem 1.5rem;
	}

	.hero {
		text-align: left;
		padding: 1rem 0;
	}

	.hero-logo {
		width: 110px;
		height: auto;
		margin-bottom: 1rem;
		display: block;
	}

	.main-title {
		font-size: 2.2rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		margin: 0 0 0.4rem 0;
	}

	.tagline {
		font-size: 1rem;
		color: #666056;
		margin: 0;
	}

	hr {
		border: 0;
		border-top: 1px solid #e2dbce;
		margin: 2.5rem 0;
	}

	.section-title {
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		margin-bottom: 1.5rem;
		color: #e05a2b; /* acento terracota tomado de la estrella */
	}

	.grid-posts {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.post-card {
		border-bottom: 1px solid #e2dbce;
		padding-bottom: 1.5rem;
	}

	.category {
		font-size: 0.75rem;
		letter-spacing: 0.05em;
		color: #e6397d; /* acento magenta del logo */
		font-weight: 600;
		display: block;
		margin-bottom: 0.3rem;
	}

	.post-title {
		margin: 0 0 0.5rem 0;
		font-size: 1.3rem;
		font-weight: 500;
	}

	.post-title a {
		color: #1a1918;
		text-decoration: none;
	}

	.post-title a:hover {
		color: #e6397d;
	}

	.excerpt {
		color: #4a453e;
		font-size: 0.95rem;
		line-height: 1.6;
		margin: 0;
	}
</style>