---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Publicaciones ordenadas por fecha (más reciente primero)
const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main class="container">
			<section class="masthead">
				<p class="tagline">revista literaria · ensayo, crítica y creación</p>
			</section>

			<section class="feed">
				{posts.length === 0 && <p class="empty">Todavía no hay publicaciones.</p>}

				<div class="grid-posts">
					{posts.map((post) => <PostCard post={post} />)}
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(body) {
		background-color: #f5f0e6;
		color: #1a1918;
		font-family: var(--font-atkinson), -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
		margin: 0;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 1.5rem 1.5rem 4rem;
	}

	.masthead {
		text-align: center;
		margin: 0.5rem 0 2rem;
	}
	.tagline {
		font-size: 0.95rem;
		letter-spacing: 0.02em;
		color: #7a7266;
		margin: 0;
	}

	.empty {
		text-align: center;
		color: #7a7266;
	}

	.grid-posts {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	@media (max-width: 900px) {
		.grid-posts {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 560px) {
		.grid-posts {
			grid-template-columns: 1fr;
		}
	}
</style>
