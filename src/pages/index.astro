---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Monogram from '../components/Monogram.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const DEFAULT_COVER = '/default-cover.svg';
const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = posts[0];
const rest = posts.slice(1);

// Normaliza texto para búsqueda (minúsculas, sin acentos).
const norm = (s: string) =>
	(s || '')
		.toLowerCase()
		.normalize('NFD')
		.replace(/[̀-ͯ]/g, '');
// Texto buscable de un post: título + autor + categoría.
const searchText = (p: (typeof posts)[number]) =>
	norm(`${p.data.title} ${p.data.author ?? ''} ${p.data.category ?? ''}`);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main>
			<section class="hero at-container">
				<div class="hero-copy">
					<p class="hero-name">abulia terminal <span>· revista literaria</span></p>
					<h1 class="hero-logo"><Monogram /></h1>
					<p class="hero-tag">literatura y fenómenos culturales</p>
					<p class="hero-sub">
						<span class="chev">&gt;</span> revista digital para difusión y crítica de fenómenos
						asociados y vinculables con la literatura
					</p>
				</div>

				{
					featured && (
						<a class="hero-visual" href={`/blog/${featured.id}/`}>
							<img
								class="at-duotone"
								src={featured.data.heroImage || DEFAULT_COVER}
								alt={featured.data.title}
								width="1000"
								height="1200"
								style={`object-position: ${featured.data.imagePosition || 'center'};`}
							/>
							{featured.data.category && <span class="at-tag">{featured.data.category}</span>}
							<span class="hero-cap">
								<span class="feat-label">// destacado</span>
								<span class="hero-cap-title">{featured.data.title}</span>
								<span class="hero-cap-meta">
									{featured.data.author && <b>{featured.data.author}</b>}
									{featured.data.author && ' — '}
									<FormattedDate date={featured.data.date} />
								</span>
							</span>
						</a>
					)
				}
			</section>

			<hr class="at-rule" />

			<section class="index at-container">
				<div class="index-head">
					<span>índice</span>
					<span class="count">{posts.length} pieza{posts.length === 1 ? '' : 's'}</span>
				</div>

				<div class="index-search">
					<span class="search-chev">&gt;</span>
					<input
						id="buscador"
						type="search"
						placeholder="buscar por título o autor…"
						autocomplete="off"
						aria-label="Buscar en el índice"
					/>
				</div>

				{rest.length === 0 && posts.length <= 1 && (
					<p class="empty">// sin más publicaciones por ahora</p>
				)}

				{
					featured && (
						<a
							class="row is-feat"
							href={`/blog/${featured.id}/`}
							data-search={searchText(featured)}
						>
							<span class="rnum feat">✦</span>
							<span class="rthumb">
								<img
									class="at-duotone"
									src={featured.data.heroImage || DEFAULT_COVER}
									alt={featured.data.title}
									loading="lazy"
									width="240"
									height="160"
									style={`object-position: ${featured.data.imagePosition || 'center'};`}
								/>
							</span>
							<span class="rmain">
								<span class="rtitle">{featured.data.title}</span>
								{featured.data.category && <span class="rcat">{featured.data.category}</span>}
							</span>
							<span class="rmeta">
								<FormattedDate date={featured.data.date} />
								{featured.data.author && <br />}
								{featured.data.author}
							</span>
						</a>
					)
				}

				{
					rest.map((post, i) => (
						<a class="row" href={`/blog/${post.id}/`} data-search={searchText(post)}>
							<span class="rnum">{String(i + 1).padStart(2, '0')}</span>
							<span class="rthumb">
								<img
									class="at-duotone"
									src={post.data.heroImage || DEFAULT_COVER}
									alt={post.data.title}
									loading="lazy"
									width="240"
									height="160"
									style={`object-position: ${post.data.imagePosition || 'center'};`}
								/>
							</span>
							<span class="rmain">
								<span class="rtitle">{post.data.title}</span>
								{post.data.category && <span class="rcat">{post.data.category}</span>}
							</span>
							<span class="rmeta">
								<FormattedDate date={post.data.date} />
								{post.data.author && <br />}
								{post.data.author}
							</span>
						</a>
					))
				}

				<p id="sin-resultados" class="empty" style="display:none">// sin resultados</p>
			</section>

			<script is:inline>
				(function () {
					var input = document.getElementById('buscador');
					if (!input) return;
					var rows = Array.prototype.slice.call(document.querySelectorAll('.index .row'));
					var empty = document.getElementById('sin-resultados');
					function norm(s) {
						return (s || '')
							.toLowerCase()
							.normalize('NFD')
							.replace(/[̀-ͯ]/g, '');
					}
					function apply() {
						var q = norm(input.value.trim());
						var visible = 0;
						rows.forEach(function (r) {
							var show;
							if (!q) {
								show = !r.classList.contains('is-feat');
							} else {
								show = (r.getAttribute('data-search') || '').indexOf(q) !== -1;
							}
							r.style.display = show ? 'grid' : 'none';
							if (show) visible++;
						});
						if (empty) empty.style.display = q && visible === 0 ? 'block' : 'none';
					}
					input.addEventListener('input', apply);
					apply();
				})();
			</script>
		</main>

		<Footer />
	</body>
</html>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: 2.5rem;
		align-items: center;
		padding: 3.2rem 1.5rem 2.4rem;
	}
	.hero-copy {
		min-width: 0;
	}
	.hero-logo {
		margin: 0;
		font-size: clamp(4.5rem, 12vw, 9.5rem);
		line-height: 0.8;
	}
	.hero-name {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
		margin: 0 0 0.9rem;
	}
	.hero-name span {
		color: var(--pink);
	}
	.hero-tag {
		font-family: var(--font-display);
		font-weight: 900;
		font-style: italic;
		font-size: clamp(1.5rem, 3vw, 2.2rem);
		line-height: 1.08;
		letter-spacing: -0.01em;
		margin: 1rem 0 0;
		max-width: 20ch;
	}
	.hero-sub {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		line-height: 1.6;
		max-width: 40rem;
		margin: 1.2rem 0 0;
		color: var(--text-soft);
	}
	.chev {
		color: var(--pink);
		font-weight: 700;
	}

	.hero-visual {
		position: relative;
		display: block;
		aspect-ratio: 5 / 6;
		border: 2px solid var(--ink);
		overflow: hidden;
		text-decoration: none;
		color: var(--paper);
		box-shadow: 10px 10px 0 var(--pink);
	}
	.hero-visual img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.5s ease;
	}
	.hero-visual:hover img {
		transform: scale(1.04);
	}
	.hero-visual .at-tag {
		position: absolute;
		top: 14px;
		left: -8px;
	}
	.hero-cap {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 1.4rem 1.1rem 1rem;
		background: linear-gradient(to top, rgba(19, 18, 17, 0.92), rgba(19, 18, 17, 0));
	}
	.feat-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--pink);
	}
	.hero-cap-title {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: clamp(1.3rem, 2.4vw, 1.75rem);
		line-height: 1.05;
		/* Siempre claro: va sobre el degradado oscuro de la imagen, en ambos modos. */
		color: var(--crema);
	}
	.hero-cap-meta {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: #d8ccb6;
	}
	.hero-cap-meta b {
		color: var(--paper);
	}

	.index {
		padding-bottom: 4rem;
	}
	.index-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		padding: 0.6rem 0;
		border-top: 2px solid var(--ink);
	}
	.index-head .count {
		color: var(--pink);
	}
	.index-search {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		border: 2px solid var(--ink);
		background: var(--paper);
		padding: 0.55rem 0.8rem;
		margin: 0 0 0.4rem;
	}
	.search-chev {
		font-family: var(--font-mono);
		font-weight: 700;
		color: var(--pink);
	}
	.index-search input {
		flex: 1;
		min-width: 0;
		border: 0;
		background: transparent;
		font-family: var(--font-mono);
		font-size: 0.9rem;
		color: var(--ink);
		outline: none;
		padding: 0;
	}
	.index-search input::placeholder {
		color: var(--muted);
	}
	.index-search:focus-within {
		box-shadow: 4px 4px 0 var(--pink);
	}
	.row.is-feat {
		display: none;
	}
	.rnum.feat {
		color: var(--pink);
	}
	.empty {
		font-family: var(--font-mono);
		color: var(--muted);
		padding: 1rem 0;
	}
	.row {
		display: grid;
		grid-template-columns: 40px 84px 1fr auto;
		gap: 1.1rem;
		align-items: center;
		padding: 1.1rem 0;
		border-top: 1px solid var(--line);
		text-decoration: none;
		color: var(--ink);
	}
	.row:hover {
		background: var(--paper-2);
	}
	.rnum {
		font-family: var(--font-mono);
		font-weight: 700;
		color: var(--pink);
	}
	.rthumb {
		width: 84px;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		border: 2px solid var(--ink);
		display: block;
	}
	.rthumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.4s ease;
	}
	.row:hover .rthumb img {
		transform: scale(1.06);
	}
	.rtitle {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.35rem;
		line-height: 1.1;
		display: block;
	}
	.rcat {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted);
	}
	.rmeta {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--muted);
		text-align: right;
		white-space: nowrap;
	}

	@media (max-width: 820px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 1.8rem;
		}
		.hero-visual {
			aspect-ratio: 3 / 2;
			box-shadow: 7px 7px 0 var(--pink);
		}
	}
	@media (max-width: 720px) {
		.row {
			grid-template-columns: 26px 60px 1fr;
			gap: 0.8rem;
		}
		.rthumb {
			width: 60px;
		}
		.rmeta {
			display: none;
		}
	}

	@media (max-width: 560px) {
		.hero {
			padding: 1.8rem 1.5rem 2.2rem;
			gap: 1.6rem;
		}
		.hero-logo {
			display: none;
		}
		.hero-tag {
			margin-top: 1rem;
			font-size: clamp(2rem, 9vw, 2.6rem);
			max-width: none;
		}
		.hero-sub {
			margin-top: 1rem;
			font-size: 0.85rem;
		}
	}
</style>
