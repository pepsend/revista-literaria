---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Monogram from '../components/Monogram.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_TAGLINE } from '../consts';
import { getOptimizedImageUrl, getResponsiveSrcSet } from '../utils/images';

const DEFAULT_COVER = '/default-cover.svg';
const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const novedades = (await getCollection('prensa'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);
const featured = posts[0];
const rest = posts.slice(1);

// Normaliza texto para búsqueda (minúsculas, sin acentos).
const norm = (s: string) =>
	(s || '')
		.toLowerCase()
		.normalize('NFD')
		.replace(/[̀-ͯ]/g, '');
// Texto buscable de un post: título + autor + categoría.
const searchText = (p: (typeof posts)[number]) =>
	norm(`${p.data.title} ${p.data.author ?? ''} ${p.data.category ?? ''}`);

// Datos estructurados Schema.org para la portada
const homeJsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': 'https://abuliaterminal.cl/#website',
			url: 'https://abuliaterminal.cl/',
			name: 'abulia terminal',
			headline: `${SITE_TITLE} · ${SITE_TAGLINE}`,
			description: SITE_DESCRIPTION,
			inLanguage: 'es',
			publisher: {
				'@id': 'https://abuliaterminal.cl/#organization',
			},
		},
		{
			'@type': 'NewsMediaOrganization',
			'@id': 'https://abuliaterminal.cl/#organization',
			name: 'abulia terminal',
			url: 'https://abuliaterminal.cl/',
			logo: {
				'@type': 'ImageObject',
				url: 'https://abuliaterminal.cl/og-default.png',
			},
			issn: '3087-3258',
			sameAs: ['https://instagram.com/abuliaterminal'],
		},
		{
			'@type': 'Periodical',
			'@id': 'https://abuliaterminal.cl/#periodical',
			name: 'abulia terminal',
			issn: '3087-3258',
			url: 'https://abuliaterminal.cl/',
			inLanguage: 'es',
		},
	],
};
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`${SITE_TITLE} · ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(homeJsonLd)} />
	</head>
	<body>
		<Header />

		<main>
			<section class="hero at-container">
				<div class="hero-copy">
					<p class="hero-name">abulia terminal <span>· revista literaria</span></p>
					<h1 class="hero-logo">
						<span class="sr-only">abulia terminal · revista de literatura, ensayo y crítica cultural</span>
						<Monogram />
					</h1>
					<p class="hero-tag">literatura y fenómenos culturales</p>
					<p class="hero-sub">
						<span class="chev">—</span> revista digital para difusión y crítica de fenómenos
						asociados y vinculables con la literatura
					</p>
				</div>

				{
					featured && (
						<a class="hero-visual" href={`/blog/${featured.id}/`} aria-label={`Artículo destacado: ${featured.data.title}`}>
							<img
								class="at-duotone"
								src={getOptimizedImageUrl(featured.data.heroImage, { width: 1000, height: 1200, crop: 'fill', quality: 'auto:good' })}
								srcset={getResponsiveSrcSet(featured.data.heroImage, [480, 720, 960, 1200], 5 / 6)}
								sizes="(max-width: 820px) 100vw, 550px"
								alt={featured.data.title}
								width="1000"
								height="1200"
								fetchpriority="high"
								loading="eager"
								decoding="async"
								style={`object-position: ${featured.data.imagePosition || 'center'};`}
							/>
							{featured.data.category && <span class="at-tag">{featured.data.category}</span>}
							<span class="hero-cap">
								<span class="feat-label">en portada</span>
								<span class="hero-cap-title">{featured.data.title}</span>
								<span class="hero-cap-meta">
									{featured.data.author && <b>{featured.data.author}</b>}
									{featured.data.author && ' — '}
									<FormattedDate date={featured.data.date} />
								</span>
							</span>
						</a>
					)
				}
			</section>

			{
				novedades.length > 0 && (
					<section class="gaceta-section">
						<div class="at-container">
							<div class="gaceta-bar">
								<div class="gaceta-title">
									novedades <span>· agenda & prensa</span>
								</div>
								<a class="gaceta-link-all" href="/novedades">
									todas las novedades →
								</a>
							</div>

							<div class="gaceta-grid" data-count={novedades.length}>
								{novedades.map((item) => (
									<a class="gaceta-item" href={`/novedades/${item.id}/`}>
										{item.data.heroImage && (
											<img
												class="gaceta-thumb at-duotone"
												src={getOptimizedImageUrl(item.data.heroImage, { width: 160, height: 240, crop: 'fill', quality: 'auto:good' })}
												alt={item.data.title}
												loading="lazy"
												decoding="async"
												width="80"
												height="120"
												style={`object-position: ${item.data.imagePosition || 'center'};`}
											/>
										)}
										<div class="gaceta-content">
											<span class="gaceta-meta-tag">{item.data.type || 'Novedad'}</span>
											<h3 class="gaceta-item-title">{item.data.title}</h3>
											{item.data.summary && <p class="gaceta-item-desc">{item.data.summary}</p>}
											<div class="gaceta-item-foot">
												{item.data.eventDates || item.data.location || <FormattedDate date={item.data.date} />}
											</div>
										</div>
									</a>
								))}
							</div>
						</div>
					</section>
				)
			}

			<hr class="at-rule" />

			<section class="index at-container">
				<div class="index-head">
					<span>índice general</span>
					<span class="count">{posts.length} pieza{posts.length === 1 ? '' : 's'}</span>
				</div>

				<div class="index-search">
					<svg class="search-icon-svg" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
						<circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" fill="none" />
						<line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
					</svg>
					<input
						id="buscador"
						type="search"
						placeholder="buscar por título o autor…"
						autocomplete="off"
						aria-label="Buscar en el índice"
					/>
				</div>

				{rest.length === 0 && posts.length <= 1 && (
					<p class="empty">fin del archivo por ahora</p>
				)}

				{
					featured && (
						<a
							class="row is-feat"
							href={`/blog/${featured.id}/`}
							data-search={searchText(featured)}
						>
							<span class="rnum feat">✦</span>
							<span class="rthumb">
								<img
									class="at-duotone"
									src={getOptimizedImageUrl(featured.data.heroImage, { width: 168, height: 112, crop: 'fill', quality: 'auto:good' })}
									alt={featured.data.title}
									loading="lazy"
									decoding="async"
									width="84"
									height="56"
									style={`object-position: ${featured.data.imagePosition || 'center'};`}
								/>
							</span>
							<span class="rmain">
								<span class="rtitle">{featured.data.title}</span>
								{featured.data.category && <span class="rcat">{featured.data.category}</span>}
							</span>
							<span class="rmeta">
								<FormattedDate date={featured.data.date} />
								{featured.data.author && <br />}
								{featured.data.author}
							</span>
						</a>
					)
				}

				{
					rest.map((post, i) => (
						<a class="row" href={`/blog/${post.id}/`} data-search={searchText(post)}>
							<span class="rnum">{String(i + 1).padStart(2, '0')}</span>
							<span class="rthumb">
								<img
									class="at-duotone"
									src={getOptimizedImageUrl(post.data.heroImage, { width: 168, height: 112, crop: 'fill', quality: 'auto:good' })}
									alt={post.data.title}
									loading="lazy"
									decoding="async"
									width="84"
									height="56"
									style={`object-position: ${post.data.imagePosition || 'center'};`}
								/>
							</span>
							<span class="rmain">
								<span class="rtitle">{post.data.title}</span>
								{post.data.category && <span class="rcat">{post.data.category}</span>}
							</span>
							<span class="rmeta">
								<FormattedDate date={post.data.date} />
								{post.data.author && <br />}
								{post.data.author}
							</span>
						</a>
					))
				}

				<p id="sin-resultados" class="empty" style="display:none">sin resultados para esta búsqueda</p>
			</section>

			<script is:inline>
				(function () {
					var input = document.getElementById('buscador');
					if (!input) return;
					var rows = Array.prototype.slice.call(document.querySelectorAll('.index .row'));
					var empty = document.getElementById('sin-resultados');
					function norm(s) {
						return (s || '')
							.toLowerCase()
							.normalize('NFD')
							.replace(/[̀-ͯ]/g, '');
					}
					function apply() {
						var q = norm(input.value.trim());
						var visible = 0;
						rows.forEach(function (r) {
							var show;
							if (!q) {
								show = !r.classList.contains('is-feat');
							} else {
								show = (r.getAttribute('data-search') || '').indexOf(q) !== -1;
							}
							r.style.display = show ? 'grid' : 'none';
							if (show) visible++;
						});
						if (empty) empty.style.display = q && visible === 0 ? 'block' : 'none';
					}
					input.addEventListener('input', apply);
					apply();
				})();
			</script>
		</main>

		<Footer />
	</body>
</html>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: 2.5rem;
		align-items: center;
		padding: 3.2rem 1.5rem 2.4rem;
	}
	.hero-copy {
		min-width: 0;
	}
	.hero-logo {
		margin: 0;
		font-size: clamp(4.5rem, 12vw, 9.5rem);
		line-height: 0.8;
	}
	.hero-name {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
		margin: 0 0 0.9rem;
	}
	.hero-name span {
		color: var(--pink);
	}
	.hero-tag {
		font-family: var(--font-display);
		font-weight: 900;
		font-style: italic;
		font-size: clamp(1.5rem, 3vw, 2.2rem);
		line-height: 1.08;
		letter-spacing: -0.01em;
		margin: 1rem 0 0;
		max-width: 20ch;
	}
	.hero-sub {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		line-height: 1.6;
		max-width: 40rem;
		margin: 1.2rem 0 0;
		color: var(--text-soft);
	}
	.chev {
		color: var(--pink);
		font-weight: 700;
	}

	.hero-visual {
		position: relative;
		display: block;
		aspect-ratio: 5 / 6;
		border: 2px solid var(--ink);
		overflow: hidden;
		text-decoration: none;
		color: var(--paper);
		box-shadow: 6px 6px 0 var(--ink);
		background: var(--paper-2);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.hero-visual img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.5s ease;
	}
	.hero-visual:hover {
		transform: translate(-2px, -2px);
		box-shadow: 8px 8px 0 var(--ink);
	}
	.hero-visual:hover img {
		transform: scale(1.03);
	}
	.hero-visual .at-tag {
		position: absolute;
		top: 14px;
		left: 14px;
	}
	.hero-cap {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 1.4rem 1.1rem 1rem;
		background: linear-gradient(to top, rgba(19, 18, 17, 0.92), rgba(19, 18, 17, 0));
	}
	.feat-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--pink);
	}
	.hero-cap-title {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: clamp(1.3rem, 2.4vw, 1.75rem);
		line-height: 1.05;
		color: var(--crema);
	}
	.hero-cap-meta {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: #d8ccb6;
	}
	.hero-cap-meta b {
		color: var(--paper);
	}

	.index {
		padding-bottom: 4rem;
	}
	.index-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		padding: 0.6rem 0;
		border-top: 2px solid var(--ink);
	}
	.index-head .count {
		color: var(--pink);
	}
	.index-search {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		border: 2px solid var(--ink);
		background: var(--paper);
		padding: 0.6rem 0.85rem;
		margin: 0 0 0.4rem;
		min-height: 44px;
	}
	.search-icon-svg {
		color: var(--ink);
		stroke: var(--ink);
		flex-shrink: 0;
		opacity: 0.75;
	}

	/* Franja Gaceta de Novedades */
	.gaceta-section {
		background: var(--paper);
		border-top: 2px solid var(--ink);
		border-bottom: 2px solid var(--ink);
		padding: 1.4rem 0 1.6rem;
	}
	.gaceta-bar {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding-bottom: 0.5rem;
		margin-bottom: 1.2rem;
		border-bottom: 1px solid var(--line);
		font-family: var(--font-mono);
	}
	.gaceta-title {
		font-size: 0.72rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--ink);
		font-weight: 700;
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
	}
	.gaceta-title span {
		color: var(--pink);
	}
	.gaceta-link-all {
		font-size: 0.72rem;
		color: var(--muted);
		text-decoration: none;
		letter-spacing: 0.05em;
		transition: color 0.15s;
	}
	.gaceta-link-all:hover {
		color: var(--pink);
		text-decoration: underline;
	}
	.gaceta-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.6rem;
		align-items: start;
	}
	.gaceta-grid[data-count="1"] {
		grid-template-columns: 1fr;
		max-width: 680px;
	}
	.gaceta-grid[data-count="1"] .gaceta-item {
		grid-template-columns: 90px 1fr;
		border-right: none;
		padding-right: 0;
	}
	.gaceta-grid[data-count="2"] {
		grid-template-columns: repeat(2, 1fr);
	}
	.gaceta-item {
		text-decoration: none;
		color: var(--ink);
		display: grid;
		grid-template-columns: 80px 1fr;
		gap: 0.95rem;
		align-items: start;
		padding-right: 1.4rem;
		border-right: 1px solid var(--line);
		min-height: 100%;
	}
	.gaceta-item:last-child {
		border-right: none;
		padding-right: 0;
	}
	.gaceta-item:hover .gaceta-item-title {
		color: var(--pink);
	}
	.gaceta-thumb {
		width: 80px;
		max-width: 100%;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border: 1.5px solid var(--ink);
		box-shadow: 2px 2px 0 var(--ink);
		background: var(--paper-2);
		display: block;
		flex-shrink: 0;
	}
	.gaceta-content {
		min-width: 0;
	}
	.gaceta-meta-tag {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--pink);
		font-weight: 700;
		display: block;
		margin-bottom: 0.3rem;
	}
	.gaceta-item-title {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.05rem;
		line-height: 1.2;
		margin-bottom: 0.35rem;
		letter-spacing: -0.01em;
		transition: color 0.15s;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.gaceta-item-desc {
		font-size: 0.74rem;
		line-height: 1.45;
		color: var(--text-soft);
		margin-bottom: 0.5rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.gaceta-item-foot {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--muted);
		border-top: 1px solid var(--line);
		padding-top: 0.35rem;
	}
	.index-search input {
		flex: 1;
		min-width: 0;
		border: 0;
		background: transparent;
		font-family: var(--font-mono);
		font-size: 0.9rem;
		color: var(--ink);
		outline: none;
		padding: 0;
	}
	.index-search input::placeholder {
		color: var(--muted);
	}
	.index-search:focus-within {
		box-shadow: 3px 3px 0 var(--ink);
	}
	.row.is-feat {
		display: none;
	}
	.rnum.feat {
		color: var(--pink);
	}
	.empty {
		font-family: var(--font-mono);
		color: var(--muted);
		padding: 1rem 0;
	}
	.row {
		display: grid;
		grid-template-columns: 40px 84px 1fr auto;
		gap: 1.1rem;
		align-items: center;
		padding: 1.1rem 0;
		border-top: 1px solid var(--line);
		text-decoration: none;
		color: var(--ink);
		min-height: 60px;
	}
	.row:hover {
		background: var(--paper-2);
	}
	.rnum {
		font-family: var(--font-mono);
		font-weight: 700;
		color: var(--pink);
	}
	.rthumb {
		width: 84px;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		border: 2px solid var(--ink);
		display: block;
		background: var(--paper-2);
	}
	.rthumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.4s ease;
	}
	.row:hover .rthumb img {
		transform: scale(1.06);
	}
	.rtitle {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.35rem;
		line-height: 1.1;
		display: block;
	}
	.rcat {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted);
	}
	.rmeta {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--muted);
		text-align: right;
		white-space: nowrap;
	}

	@media (max-width: 820px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 1.8rem;
		}
		.hero-visual {
			aspect-ratio: 3 / 2;
			box-shadow: 4px 4px 0 var(--ink);
		}
		.gaceta-grid {
			grid-template-columns: 1fr;
			gap: 1.1rem;
		}
		.gaceta-item {
			border-right: none;
			padding-right: 0;
			border-bottom: 1px solid var(--line);
			padding-bottom: 1rem;
			grid-template-columns: 75px 1fr;
			gap: 0.85rem;
		}
		.gaceta-item:last-child {
			border-bottom: none;
			padding-bottom: 0;
		}
		.gaceta-thumb {
			width: 75px;
			max-width: 75px;
		}
		.gaceta-item-title {
			font-size: 0.95rem;
			line-height: 1.2;
		}
		.gaceta-item-desc {
			font-size: 0.72rem;
			line-height: 1.4;
		}
	}
	@media (max-width: 720px) {
		.row {
			grid-template-columns: 26px 60px 1fr;
			gap: 0.8rem;
		}
		.rthumb {
			width: 60px;
		}
		.rmeta {
			display: none;
		}
	}

	@media (max-width: 560px) {
