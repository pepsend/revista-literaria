---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Monogram from '../components/Monogram.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const DEFAULT_COVER = '/default-cover.svg';
const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = posts[0];
const rest = posts.slice(1);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main>
			<section class="hero at-container">
				<div class="hero-copy">
					<p class="at-kicker">iniciativa independiente · revista digital</p>
					<h1 class="hero-logo"><Monogram /></h1>
					<p class="hero-name">abulia terminal <span>· revista literaria</span></p>
					<p class="hero-tag">literatura y fenómenos culturales</p>
					<p class="hero-sub">
						<span class="chev">&gt;</span> revista digital para difusión y crítica de fenómenos
						asociados y vinculables con la literatura
					</p>
				</div>

				{
					featured && (
						<a class="hero-visual" href={`/blog/${featured.id}/`}>
							<img
								class="at-duotone"
								src={featured.data.heroImage || DEFAULT_COVER}
								alt={featured.data.title}
								style={`object-position: ${featured.data.imagePosition || 'center'};`}
							/>
							{featured.data.category && <span class="at-tag">{featured.data.category}</span>}
							<span class="hero-cap">
								<span class="feat-label">// destacado</span>
								<span class="hero-cap-title">{featured.data.title}</span>
								<span class="hero-cap-meta">
									{featured.data.author && <b>{featured.data.author}</b>}
									{featured.data.author && ' — '}
									<FormattedDate date={featured.data.date} />
								</span>
							</span>
						</a>
					)
				}
			</section>

			<hr class="at-rule" />

			<section class="index at-container">
				<div class="index-head">
					<span>índice</span>
					<span class="count">{posts.length} pieza{posts.length === 1 ? '' : 's'}</span>
				</div>

				{rest.length === 0 && posts.length <= 1 && (
					<p class="empty">// sin más publicaciones por ahora</p>
				)}

				{
					rest.map((post, i) => (
						<a class="row" href={`/blog/${post.id}/`}>
							<span class="rnum">{String(i + 1).padStart(2, '0')}</span>
							<span class="rmain">
								<span class="rtitle">{post.data.title}</span>
								{post.data.category && <span class="rcat">{post.data.category}</span>}
							</span>
							<span class="rmeta">
								<FormattedDate date={post.data.date} />
								{post.data.author && <br />}
								{post.data.author}
							</span>
						</a>
					))
				}
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: 2.5rem;
		align-items: start;
		padding: 3.2rem 1.5rem 2.4rem;
	}
	.hero-copy {
		min-width: 0;
	}
	.hero-logo {
		margin: 0.7rem 0 0;
		font-size: clamp(4.5rem, 12vw, 9.5rem);
		line-height: 0.8;
	}
	.hero-name {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
		margin: 1.1rem 0 0;
	}
	.hero-name span {
		color: var(--pink);
	}
	.hero-tag {
		font-family: var(--font-display);
		font-weight: 900;
		font-style: italic;
		font-size: clamp(1.5rem, 3vw, 2.2rem);
		line-height: 1.08;
		letter-spacing: -0.01em;
		margin: 1rem 0 0;
		max-width: 20ch;
	}
	.hero-sub {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		line-height: 1.6;
		max-width: 40rem;
		margin: 1.2rem 0 0;
		color: #42392c;
	}
	.chev {
		color: var(--pink);
		font-weight: 700;
	}

	.hero-visual {
		position: relative;
		display: block;
		aspect-ratio: 4 / 5;
		border: 2px solid var(--ink);
		overflow: hidden;
		text-decoration: none;
		color: var(--paper);
		box-shadow: 10px 10px 0 var(--pink);
	}
	.hero-visual img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.5s ease;
	}
	.hero-visual:hover img {
		transform: scale(1.04);
	}
	.hero-visual .at-tag {
		position: absolute;
		top: 14px;
		left: -8px;
	}
	.hero-cap {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 1.4rem 1.1rem 1rem;
		background: linear-gradient(to top, rgba(19, 18, 17, 0.92), rgba(19, 18, 17, 0));
	}
	.feat-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--pink);
	}
	.hero-cap-title {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: clamp(1.3rem, 2.4vw, 1.75rem);
		line-height: 1.05;
		color: var(--paper);
	}
	.hero-cap-meta {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: #d8ccb6;
	}
	.hero-cap-meta b {
		color: var(--paper);
	}

	.index {
		padding-bottom: 4rem;
	}
	.index-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		padding: 0.6rem 0;
		border-top: 2px solid var(--ink);
	}
	.index-head .count {
		color: var(--pink);
	}
	.empty {
		font-family: var(--font-mono);
		color: var(--muted);
		padding: 1rem 0;
	}
	.row {
		display: grid;
		grid-template-columns: 42px 1fr auto;
		gap: 1rem;
		align-items: baseline;
		padding: 1.1rem 0;
		border-top: 1px solid var(--line);
		text-decoration: none;
		color: var(--ink);
	}
	.row:hover {
		background: var(--paper-2);
	}
	.rnum {
		font-family: var(--font-mono);
		font-weight: 700;
		color: var(--pink);
	}
	.rtitle {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.35rem;
		line-height: 1.1;
		display: block;
	}
	.rcat {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted);
	}
	.rmeta {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--muted);
		text-align: right;
		white-space: nowrap;
	}

	@media (max-width: 820px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 1.8rem;
		}
		.hero-visual {
			aspect-ratio: 3 / 2;
			box-shadow: 7px 7px 0 var(--pink);
		}
	}
	@media (max-width: 720px) {
		.row {
			grid-template-columns: 30px 1fr;
		}
		.rmeta {
			display: none;
		}
	}
</style>
