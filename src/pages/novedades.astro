---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_TITLE } from '../consts';

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Novedades · ${SITE_TITLE}`} description="Últimas publicaciones de la revista" />
	</head>
	<body>
		<Header />
		<main class="container">
			<h1 class="page-title">novedades</h1>

			{posts.length === 0 && <p class="empty">Todavía no hay publicaciones.</p>}

			<div class="grid-posts">
				{posts.map((post) => <PostCard post={post} />)}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(body) {
		background-color: #f5f0e6;
		color: #1a1918;
		font-family: var(--font-atkinson), -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
		margin: 0;
	}
	.container { max-width: 1200px; margin: 0 auto; padding: 1.5rem 1.5rem 4rem; }
	.page-title { text-transform: lowercase; color: #e05a2b; margin: 0.5rem 0 1.5rem; }
	.empty { color: #7a7266; }
	.grid-posts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
	@media (max-width: 900px) { .grid-posts { grid-template-columns: repeat(2, 1fr); } }
	@media (max-width: 560px) { .grid-posts { grid-template-columns: 1fr; } }
</style>
