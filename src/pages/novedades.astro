---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Novedades · ${SITE_TITLE}`} description="Últimas publicaciones de la revista" />
	</head>
	<body>
		<Header />
		<main class="container">
			<h1 class="page-title">novedades</h1>

			{posts.length === 0 && <p class="empty">Todavía no hay publicaciones.</p>}

			<div class="grid-posts">
				{
					posts.map((post) => (
						<article class="post-card">
							<span class="category">{post.data.category || 'publicación'}</span>
							<h3 class="post-title">
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							</h3>
							<p class="meta">
								<FormattedDate date={post.data.date} />
								{post.data.author && <span> · {post.data.author}</span>}
							</p>
						</article>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(body) { background-color: #f5f0e6; color: #1a1918; margin: 0; }
	.container { max-width: 800px; margin: 0 auto; padding: 2.5rem 1.5rem; }
	.page-title { text-transform: lowercase; color: #e05a2b; margin-bottom: 2rem; }
	.empty { color: #666056; }
	.grid-posts { display: flex; flex-direction: column; gap: 1.5rem; }
	.post-card { border-bottom: 1px solid #e2dbce; padding-bottom: 1.2rem; }
	.category { font-size: 0.75rem; letter-spacing: 0.05em; color: #e6397d; font-weight: 600; display: block; margin-bottom: 0.3rem; }
	.post-title { margin: 0 0 0.3rem 0; font-size: 1.2rem; font-weight: 500; }
	.post-title a { color: #1a1918; text-decoration: none; }
	.post-title a:hover { color: #e6397d; }
	.meta { margin: 0; font-size: 0.85rem; color: #666056; }
</style>
