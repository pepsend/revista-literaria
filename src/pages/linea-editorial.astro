---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`línea editorial · ${SITE_TITLE}`}
			description="La línea editorial de abulia terminal"
		/>
	</head>
	<body>
		<Header />
		<main class="le at-container">
			<header class="le-head">
				<p class="le-kicker">qué somos</p>
				<h1 class="le-title">línea editorial</h1>
				<hr class="at-rule le-rule" />
			</header>

			<p class="le-lead">
				abulia terminal es una revista digital que se suma a las iniciativas
				independientes de difusión y crítica artísticas, en especial, literarias.
			</p>

			<aside class="le-panel">
				<p>
					además, buscamos generar un espacio de propuestas experimentales y arriesgadas.
				</p>
			</aside>
		</main>
		<Footer />
	</body>
</html>

<style>
	.le {
		max-width: 52rem;
		padding: 3rem 1.5rem 4.5rem;
	}
	.le-kicker {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--pink);
		margin: 0 0 0.5rem;
	}
	.le-title {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: clamp(2.6rem, 8vw, 4.6rem);
		line-height: 0.95;
		letter-spacing: -0.01em;
		text-transform: lowercase;
		margin: 0;
	}
	.le-rule {
		margin: 1.4rem 0 0;
	}

	/* Frase de entrada grande, tipo declaración */
	.le-lead {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: clamp(1.5rem, 3.6vw, 2.35rem);
		line-height: 1.3;
		letter-spacing: -0.01em;
		color: var(--ink);
		margin: 2rem 0 0;
	}

	/* Panel oscuro "terminal" con sombra magenta dura */
	.le-panel {
		margin: 2.4rem 0 0;
		background: var(--negro);
		color: var(--crema);
		border: 2px solid var(--ink);
		box-shadow: 10px 10px 0 var(--pink);
		padding: 1.8rem 1.7rem 1.9rem;
	}
	.le-panel p {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(1.25rem, 2.6vw, 1.6rem);
		line-height: 1.42;
		margin: 0;
		color: var(--crema);
	}

	@media (max-width: 560px) {
		.le-panel {
			box-shadow: 6px 6px 0 var(--pink);
		}
	}
</style>
