---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`línea editorial · ${SITE_TITLE}`}
			description="La línea editorial de abulia terminal"
		/>
	</head>
	<body>
		<Header />
		<main class="le at-container">
			<header class="le-head">
				<p class="le-kicker">qué somos</p>
				<h1 class="le-title">línea editorial</h1>
				<hr class="at-rule le-rule" />
			</header>

			<p class="le-a">
				abulia terminal es una revista digital que se suma a las iniciativas
				independientes de <em>difusión y crítica artísticas</em>, en especial, literarias.
			</p>

			<span class="le-tick"></span>

			<p class="le-b">
				además, buscamos generar un espacio de <em>propuestas experimentales y
				arriesgadas</em>.
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.le {
		max-width: 50rem;
		padding: 3rem 1.5rem 5rem;
	}
	.le-kicker {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--pink);
		margin: 0 0 0.5rem;
	}
	.le-title {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: clamp(2.6rem, 8vw, 4.6rem);
		line-height: 0.95;
		letter-spacing: -0.01em;
		text-transform: lowercase;
		margin: 0;
	}
	.le-rule {
		margin: 1.4rem 0 0;
	}
	.le-a {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: clamp(1.55rem, 3.6vw, 2.4rem);
		line-height: 1.25;
		letter-spacing: -0.01em;
		color: var(--ink);
		margin: 2.4rem 0 0;
	}
	.le-a em {
		font-style: italic;
		color: var(--pink);
	}
	.le-tick {
		display: block;
		width: 84px;
		height: 5px;
		background: var(--pink);
		margin: 2.2rem 0;
	}
	.le-b {
		font-family: var(--font-display);
		font-weight: 500;
		font-style: italic;
		font-size: clamp(1.4rem, 3.2vw, 2.1rem);
		line-height: 1.3;
		color: var(--ink);
		margin: 0;
		max-width: 34ch;
	}
	.le-b em {
		font-style: italic;
		color: var(--orange);
	}
</style>
