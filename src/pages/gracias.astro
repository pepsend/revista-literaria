---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`gracias · ${SITE_TITLE}`} description="Recibimos tu colaboración" />
	</head>
	<body>
		<Header />
		<main class="gr at-container">
			<p class="gr-kicker">// recibido</p>
			<h1 class="gr-title">gracias</h1>
			<p class="gr-msg">
				recibimos tu colaboración. te confirmaremos la recepción por correo y, desde ahí,
				nos tomamos un plazo aproximado de dos semanas para revisar el texto, editarlo y
				enviarte nuestra propuesta y comentarios antes de publicarlo.
			</p>
			<p class="gr-back"><a href="/">← volver al inicio</a></p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.gr {
		max-width: 44rem;
		padding: 4rem 1.5rem 6rem;
	}
	.gr-kicker {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--pink);
		margin: 0 0 0.5rem;
	}
	.gr-title {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: clamp(2.8rem, 10vw, 5.5rem);
		line-height: 0.9;
		text-transform: lowercase;
		margin: 0 0 1.8rem;
	}
	.gr-msg {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(1.2rem, 2.8vw, 1.6rem);
		line-height: 1.5;
		color: var(--ink);
		border-left: 5px solid var(--pink);
		padding-left: 1.3rem;
		margin: 0;
		max-width: 40ch;
	}
	.gr-back {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		margin: 2.4rem 0 0;
	}
	.gr-back a {
		color: var(--pink);
		text-decoration: none;
	}
</style>
