---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_TITLE } from '../../consts';
import { CATEGORIES, categorySlug } from '../../content.config';

export async function getStaticPaths() {
	return CATEGORIES.map((name) => ({
		params: { category: categorySlug(name) },
		props: { categoryName: name },
	}));
}

const { categoryName } = Astro.props;

const posts = (await getCollection('posts'))
	.filter((post) => post.data.category === categoryName)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`${categoryName} · ${SITE_TITLE}`} description={`Artículos de la categoría ${categoryName}`} />
	</head>
	<body>
		<Header />
		<main class="listing at-container">
			<p class="at-kicker">categoría</p>
			<h1 class="listing-title">{categoryName}</h1>
			<hr class="at-rule" />
			{posts.length === 0 && <p class="empty">// aún no hay publicaciones en esta categoría</p>}
			<div class="grid">
				{posts.map((post) => <PostCard post={post} />)}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.listing { padding: 2.5rem 1.5rem 4rem; }
	.listing-title { font-family: var(--font-display); font-weight: 900; font-size: clamp(2.4rem, 7vw, 4rem); line-height: 1; margin: .5rem 0 1.2rem; text-transform: lowercase; }
	.empty { font-family: var(--font-mono); color: var(--muted); }
	.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-top: 2rem; }
	@media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
