---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { categorySlug } from '../../content.config';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';

const DEFAULT_COVER = '/default-cover.svg';

export async function getStaticPaths() {
	const posts = await getCollection('posts');
	const sorted = [...posts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

	// Agrupa los posts por autor (usando su slug como clave).
	const map = new Map<string, { name: string; posts: CollectionEntry<'posts'>[] }>();
	for (const p of sorted) {
		const name = (p.data.author || '').trim();
		if (!name) continue; // posts sin autor no generan página
		const slug = categorySlug(name);
		if (!map.has(slug)) map.set(slug, { name, posts: [] });
		map.get(slug)!.posts.push(p);
	}

	const toCard = (p: CollectionEntry<'posts'>) => ({
		slug: p.id,
		title: p.data.title,
		category: p.data.category ?? null,
		date: p.data.date,
		heroImage: p.data.heroImage ?? null,
		imagePosition: p.data.imagePosition ?? 'center',
	});

	return [...map.entries()].map(([slug, info]) => ({
		params: { autor: slug },
		props: { name: info.name, posts: info.posts.map(toCard) },
	}));
}

const { name, posts } = Astro.props;

// Bio del autor (si existe en la colección "authors"), se muestra arriba.
const authorsList = await getCollection('authors');
const authorEntry = authorsList.find((a) => a.data.name.trim() === name.trim());
const AuthorBio =
	authorEntry && authorEntry.body && authorEntry.body.trim()
		? (await render(authorEntry)).Content
		: null;
---

<html lang="es">
	<head>
		<BaseHead title={`${name} — abulia terminal`} description={`Textos de ${name} en abulia terminal`} />
	</head>
	<body>
		<Header />
		<main class="autor at-container">
			<a class="back" href="/">← índice</a>

			<header class="autor-head">
				<p class="autor-kicker">// autor</p>
				<h1 class="autor-name">{name}</h1>
				<p class="autor-count">
					{posts.length} pieza{posts.length === 1 ? '' : 's'}
				</p>
				{AuthorBio && (
					<div class="autor-bio">
						<AuthorBio />
					</div>
				)}
			</header>

			<section class="autor-list">
				{posts.map((post) => (
					<a class="row" href={`/blog/${post.slug}/`}>
						<span class="rthumb">
							<img
								class="at-duotone"
								src={post.heroImage || DEFAULT_COVER}
								alt={post.title}
								loading="lazy"
								style={`object-position: ${post.imagePosition};`}
							/>
						</span>
						<span class="rmain">
							<span class="rtitle">{post.title}</span>
							{post.category && <span class="rcat">{post.category}</span>}
						</span>
						<span class="rmeta">
							<FormattedDate date={post.date} />
						</span>
					</a>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.autor {
		padding-top: 1.5rem;
		padding-bottom: 4rem;
	}
	.back {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted);
		text-decoration: none;
	}
	.back:hover {
		color: var(--pink);
	}
	.autor-head {
		max-width: 46rem;
		margin: 2rem 0 0;
	}
	.autor-kicker {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: var(--pink);
		margin: 0 0 0.4rem;
	}
	.autor-name {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: clamp(2.4rem, 7vw, 4.5rem);
		line-height: 1.02;
		margin: 0;
	}
	.autor-count {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--muted);
		margin: 0.6rem 0 0;
	}
	.autor-bio {
		font-family: var(--font-display);
		font-size: 1.1rem;
		line-height: 1.6;
		color: #3c3428;
		margin: 1.4rem 0 0;
		max-width: 40rem;
	}
	.autor-bio :global(p) {
		margin: 0 0 0.7rem;
	}
	.autor-bio :global(a) {
		color: var(--pink);
	}
	.autor-list {
		margin: 2.5rem 0 0;
		border-top: 2px solid var(--ink);
	}
	.row {
		display: grid;
		grid-template-columns: 84px 1fr auto;
		gap: 1.1rem;
		align-items: center;
		padding: 1.1rem 0;
		border-bottom: 1px solid var(--line);
		text-decoration: none;
		color: var(--ink);
	}
	.row:hover {
		background: var(--paper-2);
	}
	.rthumb {
		width: 84px;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		border: 2px solid var(--ink);
		display: block;
	}
	.rthumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.4s ease;
	}
	.row:hover .rthumb img {
		transform: scale(1.06);
	}
	.rtitle {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.35rem;
		line-height: 1.1;
		display: block;
	}
	.rcat {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted);
	}
	.rmeta {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--muted);
		text-align: right;
		white-space: nowrap;
	}
	@media (max-width: 640px) {
		.row {
			grid-template-columns: 60px 1fr;
		}
		.rthumb {
			width: 60px;
		}
		.rmeta {
			display: none;
		}
	}
</style>
