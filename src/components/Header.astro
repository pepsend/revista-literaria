---
import Monogram from './Monogram.astro';
import { CATEGORIES, categorySlug } from '../content.config';

// Se genera desde la lista única (CATEGORIES) para no desincronizarse.
// La interfaz va en minúscula; el slug quita acentos para la URL.
const categories = CATEGORIES.map(
	(name) => [name.toLowerCase(), `/categorias/${categorySlug(name)}`] as const,
);
---

<header class="site-header">
	<div class="at-container bar">
		<a class="brand" href="/" aria-label="abulia terminal — inicio">
			<Monogram class="brand-mono" />
			<span class="brand-name">abulia terminal</span>
		</a>

		<nav class="nav">
			<a href="/novedades">novedades</a>
			<a href="/linea-editorial">línea editorial</a>
			<a href="/manifiesto">manifiesto</a>
			<a href="/colaborar">colaborar</a>
			<div class="dropdown">
				<button class="dropbtn" type="button">categorías ▾</button>
				<div class="dropdown-content">
					{categories.map(([label, href]) => <a href={href}>{label}</a>)}
				</div>
			</div>
			<a class="cta" href="/contacto">contáctanos</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--paper);
		border-bottom: 2px solid var(--ink);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 0.7rem;
		padding-bottom: 0.7rem;
		flex-wrap: wrap;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		text-decoration: none;
		color: var(--ink);
	}
	.brand :global(.brand-mono) {
		font-size: 1.7rem;
	}
	.brand-name {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: 1.25rem;
		letter-spacing: -0.01em;
	}

	.nav {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		flex-wrap: wrap;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		text-transform: none;
		letter-spacing: 0.02em;
	}
	.nav > a {
		text-decoration: none;
		color: var(--ink);
		padding: 0.4rem 0.6rem;
	}
	.nav > a:hover {
		background: var(--ink);
		color: var(--paper);
	}
	.cta {
		background: var(--orange);
		color: var(--ink) !important;
		border: 2px solid var(--ink);
		font-weight: 700;
	}
	.cta:hover {
		background: var(--ink);
		color: var(--paper) !important;
	}

	.dropdown {
		position: relative;
	}
	.dropbtn {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		text-transform: none;
		letter-spacing: 0.02em;
		color: var(--ink);
		background: transparent;
		border: none;
		cursor: pointer;
		padding: 0.4rem 0.6rem;
	}
	.dropbtn:hover {
		background: var(--ink);
		color: var(--paper);
	}
	.dropdown-content {
		display: none;
		position: absolute;
		top: 100%;
		right: 0;
		background: var(--paper);
		min-width: 210px;
		border: 2px solid var(--ink);
		padding: 0.3rem;
		z-index: 110;
	}
	.dropdown:hover .dropdown-content {
		display: block;
	}
	.dropdown-content a {
		display: block;
		text-decoration: none;
		color: var(--ink);
		padding: 0.45rem 0.6rem;
		text-transform: none;
		letter-spacing: 0;
		font-size: 0.85rem;
	}
	.dropdown-content a:hover {
		background: var(--pink);
		color: var(--ink);
	}

	@media (max-width: 760px) {
		.bar {
			flex-direction: column;
			align-items: flex-start;
		}
		.nav {
			justify-content: flex-start;
		}
		.dropdown-content {
			right: auto;
			left: 0;
		}
	}
</style>
