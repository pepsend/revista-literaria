---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Inicio</HeaderLink>
			<HeaderLink href="/novedades">Novedades</HeaderLink>
			<HeaderLink href="/linea-editorial">Línea Editorial</HeaderLink>
			<HeaderLink href="/manifiesto">Manifiesto</HeaderLink>
			<HeaderLink href="/colaborar">Colaborar</HeaderLink>
			
			<!-- Desplegable de Categorías -->
			<div class="dropdown">
				<button class="dropbtn">Categorías ▾</button>
				<div class="dropdown-content">
					<a href="/categorias/ensayo">Ensayo</a>
					<a href="/categorias/genero">Género</a>
					<a href="/categorias/critica">Crítica</a>
					<a href="/categorias/creacion-abulica">Creación Abúlica</a>
					<a href="/categorias/poesia">Poesía</a>
					<a href="/categorias/cuento">Cuento</a>
					<a href="/categorias/cronica">Crónica</a>
					<a href="/categorias/articulo">Artículo</a>
				</div>
			</div>

			<HeaderLink href="/contacto">Contáctanos</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}

	/* Estilos para el menú desplegable */
	.dropdown {
		position: relative;
		display: inline-block;
	}
	.dropbtn {
		padding: 1em 0.5em;
		color: var(--black);
		background: none;
		border: none;
		font-size: 1em;
		cursor: pointer;
		font-family: inherit;
	}
	.dropdown-content {
		display: none;
		position: absolute;
		top: 100%;
		left: 0;
		background-color: #ffffff;
		min-width: 180px;
		box-shadow: 0px 8px 16px rgba(0,0,0,0.1);
		z-index: 10;
		border: 1px solid #eaeaea;
	}
	.dropdown-content a {
		color: var(--black);
		padding: 10px 14px;
		display: block;
		border-bottom: none;
	}
	.dropdown-content a:hover {
		background-color: #f5f5f5;
	}
	.dropdown:hover .dropdown-content {
		display: block;
	}
</style>