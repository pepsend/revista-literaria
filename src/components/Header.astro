---
import { CATEGORIES, categorySlug } from '../content.config';

// Se genera desde la lista única (CATEGORIES) para no desincronizarse.
// La interfaz va en minúscula; el slug quita acentos para la URL.
const categories = CATEGORIES.map(
	(name) => [name.toLowerCase(), `/categorias/${categorySlug(name)}`] as const,
);
---

<header class="site-header" id="site-header">
	<div class="at-container bar">
		<a class="brand" href="/" aria-label="abulia terminal — inicio">
			<span class="brand-name">abulia terminal</span>
		</a>

		<div class="header-actions">
			<button
				class="header-donate-btn"
				type="button"
				data-open-donate
				aria-label="Donar a abulia terminal"
			>
				donar
			</button>
			<button class="menu-toggle" id="menu-toggle" type="button" aria-label="Abrir menú de navegación" aria-expanded="false">
				<span></span><span></span><span></span>
			</button>
		</div>

		<nav class="nav" id="nav" aria-label="Navegación principal">
			<a href="/novedades">novedades</a>
			<a href="/linea-editorial">línea editorial</a>
			<a href="/manifiesto">manifiesto</a>
			<a href="/colaborar">colaborar</a>
			<div class="dropdown" id="dropdown">
				<button class="dropbtn" type="button" aria-expanded="false">categorías ▾</button>
				<div class="dropdown-content">
					{categories.map(([label, href]) => <a href={href}>{label}</a>)}
				</div>
			</div>
			<a class="cta" href="/contacto">contáctanos</a>
			<button
				class="nav-donate-btn"
				type="button"
				data-open-donate
				aria-label="Donar a abulia terminal"
			>
				donar
			</button>
			<button
				class="theme-toggle"
				id="theme-toggle"
				type="button"
				aria-label="Cambiar a modo oscuro"
				aria-pressed="false"
			>
				☾ oscuro
			</button>
		</nav>
	</div>
</header>

<script is:inline>
	(function () {
		var header = document.getElementById('site-header');
		var toggle = document.getElementById('menu-toggle');
		var dropdown = document.getElementById('dropdown');
		if (toggle && header) {
			toggle.addEventListener('click', function () {
				var open = header.classList.toggle('nav-open');
				toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
				toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú de navegación');
			});
		}
		if (dropdown) {
			var db = dropdown.querySelector('.dropbtn');
			if (db) {
				db.addEventListener('click', function (e) {
					if (window.innerWidth <= 760) {
						e.preventDefault();
						var isOpen = dropdown.classList.toggle('open');
						db.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
					}
				});
			}
		}
		// Toggle modo Terminal (fondo negro) — persiste en localStorage.
		var themeBtn = document.getElementById('theme-toggle');
		if (themeBtn) {
			var syncLabel = function () {
				var on = document.documentElement.getAttribute('data-theme') === 'terminal';
				themeBtn.textContent = on ? '☀ claro' : '☾ oscuro';
				themeBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
				themeBtn.setAttribute(
					'aria-label',
					on ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro',
				);
			};
			themeBtn.addEventListener('click', function () {
				var on = document.documentElement.getAttribute('data-theme') === 'terminal';
				if (on) {
					document.documentElement.removeAttribute('data-theme');
					try { localStorage.setItem('at-theme', 'editorial'); } catch (e) {}
				} else {
					document.documentElement.setAttribute('data-theme', 'terminal');
					try { localStorage.setItem('at-theme', 'terminal'); } catch (e) {}
				}
				syncLabel();
			});
			syncLabel();
		}
	})();
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--paper);
		border-bottom: 2px solid var(--ink);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 0.7rem;
		padding-bottom: 0.7rem;
		flex-wrap: wrap;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		text-decoration: none;
		color: var(--ink);
		min-height: 44px;
	}
	.brand :global(.brand-mono) {
		font-size: 1.7rem;
	}
	.brand-name {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: 1.25rem;
		letter-spacing: -0.01em;
	}

	.header-actions {
		display: none;
	}
	.header-donate-btn {
		display: none;
	}
	.nav-donate-btn {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--ink);
		background: transparent;
		border: 2px solid var(--ink);
		cursor: pointer;
		padding: 0.4rem 0.75rem;
		margin-left: 0.25rem;
		min-height: 38px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		white-space: nowrap;
		letter-spacing: 0.02em;
		transition:
			background 0.15s ease,
			color 0.15s ease,
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}
	.nav-donate-btn:hover {
		background: var(--pink);
		color: var(--ink);
		box-shadow: 2px 2px 0 var(--ink);
		transform: translate(-1px, -1px);
	}

	.menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 5px;
		width: 44px;
		height: 44px;
		padding: 0 8px;
		background: transparent;
		border: 2px solid var(--ink);
		cursor: pointer;
	}
	.menu-toggle span {
		display: block;
		width: 22px;
		height: 2px;
		background: var(--ink);
		transition: transform 0.2s ease, opacity 0.2s ease;
	}
	.site-header.nav-open .menu-toggle span:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}
	.site-header.nav-open .menu-toggle span:nth-child(2) {
		opacity: 0;
	}
	.site-header.nav-open .menu-toggle span:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	.nav {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		flex-wrap: wrap;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		text-transform: none;
		letter-spacing: 0.02em;
	}
	.nav > a {
		text-decoration: none;
		color: var(--ink);
		padding: 0.4rem 0.6rem;
		min-height: 38px;
		display: inline-flex;
		align-items: center;
	}
	.nav > a:hover {
		background: var(--ink);
		color: var(--paper);
	}
	.cta {
		background: var(--orange);
		color: var(--ink) !important;
		border: 2px solid var(--ink);
		font-weight: 700;
	}
	.cta:hover {
		background: var(--ink);
		color: var(--paper) !important;
	}
	.theme-toggle {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--ink);
		background: transparent;
		border: 2px solid var(--ink);
		cursor: pointer;
		padding: 0.4rem 0.65rem;
		margin-left: 0.4rem;
		min-height: 38px;
		display: inline-flex;
		align-items: center;
		white-space: nowrap;
	}
	.theme-toggle:hover {
		background: var(--ink);
		color: var(--paper);
	}

	.dropdown {
		position: relative;
	}
	.dropbtn {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		text-transform: none;
		letter-spacing: 0.02em;
		color: var(--ink);
		background: transparent;
		border: none;
		cursor: pointer;
		padding: 0.4rem 0.6rem;
		min-height: 38px;
		display: inline-flex;
		align-items: center;
	}
	.dropbtn:hover {
		background: var(--ink);
		color: var(--paper);
	}
	.dropdown-content {
		display: none;
		position: absolute;
		top: 100%;
		right: 0;
		background: var(--paper);
		min-width: 210px;
		border: 2px solid var(--ink);
		padding: 0.3rem;
		z-index: 110;
		box-shadow: 4px 4px 0 var(--ink);
	}
	.dropdown:hover .dropdown-content {
		display: block;
	}
	.dropdown-content a {
		display: block;
		text-decoration: none;
		color: var(--ink);
		padding: 0.45rem 0.6rem;
		text-transform: none;
		letter-spacing: 0;
		font-size: 0.85rem;
	}
	.dropdown-content a:hover {
		background: var(--pink);
		color: var(--ink);
	}

	@media (max-width: 760px) {
		.site-header.nav-open {
			max-height: 100dvh;
			overflow-y: auto;
			-webkit-overflow-scrolling: touch;
		}
		.header-actions {
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}
		.header-donate-btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			font-family: var(--font-mono);
			font-size: 0.76rem;
			font-weight: 700;
			text-transform: lowercase;
			letter-spacing: 0.04em;
			color: var(--ink);
			background: var(--paper-2);
			border: 2px solid var(--ink);
			padding: 0.35rem 0.75rem;
			height: 44px;
			min-width: 60px;
			cursor: pointer;
			transition: background 0.15s ease;
		}
		.header-donate-btn:hover {
			background: var(--pink);
		}
		.menu-toggle {
			display: flex;
		}
		.nav {
			flex-basis: 100%;
			display: none;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 0.5rem 0 1.5rem;
			font-size: 0.95rem;
		}
		.site-header.nav-open .nav {
			display: flex;
		}
		.nav > a,
		.dropbtn {
			width: 100%;
			padding: 0.9rem 0.4rem;
			border-top: 1px solid var(--line);
			text-align: left;
			font-size: 0.95rem;
			min-height: 48px;
		}
		.cta {
			margin-top: 0.8rem;
			text-align: center;
			justify-content: center;
			border: 2px solid var(--ink);
			min-height: 46px;
		}
		.nav-donate-btn {
			width: 100%;
			margin: 0.6rem 0 0;
			padding: 0.85rem 0.6rem;
			text-align: center;
			justify-content: center;
			border: 2px solid var(--ink);
			background: var(--paper-2);
			font-size: 0.95rem;
			min-height: 46px;
		}
		.nav-donate-btn:hover {
			background: var(--pink);
		}
		.theme-toggle {
			width: 100%;
			margin: 0.6rem 0 0;
			padding: 0.9rem 0.4rem;
			text-align: left;
			min-height: 48px;
		}
		.dropdown {
			width: 100%;
		}
		.dropdown-content {
			position: static;
			border: none;
			box-shadow: none;
			min-width: 0;
			padding: 0 0 0.5rem 0.9rem;
			background: transparent;
		}
		.dropdown:hover .dropdown-content {
			display: none;
		}
		.dropdown.open .dropdown-content {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 0.2rem;
		}
		.dropdown-content a {
			font-size: 0.85rem;
			padding: 0.6rem 0.4rem;
			min-height: 40px;
			display: flex;
			align-items: center;
			border-left: 2px solid var(--pink);
			margin-bottom: 2px;
		}
	}
</style>
