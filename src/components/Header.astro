---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';

const categories = [
	['Ensayo', '/categorias/ensayo'],
	['Género', '/categorias/genero'],
	['Crítica', '/categorias/critica'],
	['Creación Abúlica', '/categorias/creacion-abulica'],
	['Poesía', '/categorias/poesia'],
	['Cuento', '/categorias/cuento'],
	['Crónica', '/categorias/cronica'],
	['Artículo', '/categorias/articulo'],
];
---

<div class="header-wrap">
	<header>
		<a class="brand" href="/">{SITE_TITLE}</a>

		<nav class="internal-links">
			<HeaderLink href="/">Inicio</HeaderLink>
			<HeaderLink href="/novedades">Novedades</HeaderLink>
			<HeaderLink href="/linea-editorial">Línea editorial</HeaderLink>
			<HeaderLink href="/manifiesto">Manifiesto</HeaderLink>
			<HeaderLink href="/colaborar">Colaborar</HeaderLink>

			<div class="dropdown">
				<button class="dropbtn" type="button">Categorías ▾</button>
				<div class="dropdown-content">
					{categories.map(([label, href]) => <a href={href}>{label}</a>)}
				</div>
			</div>

			<a class="cta" href="/contacto">Contáctanos</a>
		</nav>
	</header>
</div>

<style>
	.header-wrap {
		position: sticky;
		top: 0;
		z-index: 50;
		padding: 0.9rem 1.5rem;
		background: linear-gradient(#f5f0e6 70%, rgba(245, 240, 230, 0));
	}
	header {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		background: #fffdf9;
		border: 1px solid #ece4d5;
		border-radius: 999px;
		padding: 0.5rem 0.75rem 0.5rem 1.4rem;
		box-shadow: 0 6px 20px rgba(26, 25, 24, 0.07);
	}

	.brand {
		font-family: Georgia, 'Times New Roman', serif;
		font-weight: 700;
		font-size: 1.25rem;
		line-height: 1;
		color: #1a1918;
		text-decoration: none;
		text-transform: lowercase;
		white-space: nowrap;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		flex-wrap: wrap;
		justify-content: flex-end;
	}

	/* Estilo base de los enlaces (HeaderLink renderiza <a>) */
	.internal-links :global(a) {
		color: #4a453e;
		text-decoration: none;
		font-size: 0.92rem;
		padding: 0.45rem 0.75rem;
		border-radius: 999px;
		transition: background 0.15s ease, color 0.15s ease;
		white-space: nowrap;
	}
	.internal-links :global(a:hover) {
		background: #f1e9db;
		color: #1a1918;
	}
	/* Estado activo (clase que agrega HeaderLink) */
	.internal-links :global(a.active) {
		background: #e7a977;
		color: #1a1918;
		font-weight: 600;
	}

	/* Botón de contacto (CTA) — siempre destacado */
	.cta,
	.internal-links :global(a.cta) {
		background: #e05a2b !important;
		color: #fff !important;
		font-weight: 600;
		padding: 0.45rem 1rem !important;
	}
	.cta:hover {
		background: #c94a1f !important;
	}

	/* Desplegable de categorías */
	.dropdown {
		position: relative;
	}
	.dropbtn {
		font-family: inherit;
		font-size: 0.92rem;
		color: #4a453e;
		background: #f1e9db;
		border: none;
		cursor: pointer;
		padding: 0.45rem 0.85rem;
		border-radius: 999px;
		transition: background 0.15s ease;
	}
	.dropbtn:hover {
		background: #e7a977;
		color: #1a1918;
	}
	.dropdown-content {
		display: none;
		position: absolute;
		top: calc(100% + 0.5rem);
		right: 0;
		background: #fffdf9;
		min-width: 200px;
		border: 1px solid #ece4d5;
		border-radius: 14px;
		box-shadow: 0 12px 28px rgba(26, 25, 24, 0.14);
		padding: 0.4rem;
		z-index: 60;
	}
	.dropdown:hover .dropdown-content {
		display: block;
	}
	.dropdown-content a {
		display: block;
		color: #4a453e;
		padding: 0.5rem 0.75rem;
		border-radius: 8px;
		text-decoration: none;
		font-size: 0.9rem;
	}
	.dropdown-content a:hover {
		background: #f1e9db;
		color: #1a1918;
	}

	@media (max-width: 820px) {
		header {
			flex-direction: column;
			border-radius: 20px;
			align-items: stretch;
			padding: 0.9rem 1rem;
		}
		.brand {
			text-align: center;
			font-size: 1.4rem;
			margin-bottom: 0.4rem;
		}
		.internal-links {
			justify-content: center;
		}
		.dropdown-content {
			right: auto;
			left: 0;
		}
	}
</style>
