---
import { CATEGORIES, categorySlug } from '../content.config';

// Se genera desde la lista única (CATEGORIES) para no desincronizarse.
// La interfaz va en minúscula; el slug quita acentos para la URL.
const categories = CATEGORIES.map(
	(name) => [name.toLowerCase(), `/categorias/${categorySlug(name)}`] as const,
);
---

<header class="site-header" id="site-header">
	<div class="at-container bar">
		<a class="brand" href="/" aria-label="abulia terminal — inicio">
			<span class="brand-name">abulia terminal</span>
		</a>

		<button class="menu-toggle" id="menu-toggle" type="button" aria-label="menú" aria-expanded="false">
			<span></span><span></span><span></span>
		</button>

		<nav class="nav" id="nav">
			<a href="/novedades">novedades</a>
			<a href="/linea-editorial">línea editorial</a>
			<a href="/manifiesto">manifiesto</a>
			<a href="/colaborar">colaborar</a>
			<div class="dropdown" id="dropdown">
				<button class="dropbtn" type="button">categorías ▾</button>
				<div class="dropdown-content">
					{categories.map(([label, href]) => <a href={href}>{label}</a>)}
				</div>
			</div>
			<a class="cta" href="/contacto">contáctanos</a>
		</nav>
	</div>
</header>

<script is:inline>
	(function () {
		var header = document.getElementById('site-header');
		var toggle = document.getElementById('menu-toggle');
		var dropdown = document.getElementById('dropdown');
		if (toggle && header) {
			toggle.addEventListener('click', function () {
				var open = header.classList.toggle('nav-open');
				toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			});
		}
		if (dropdown) {
			var db = dropdown.querySelector('.dropbtn');
			if (db) db.addEventListener('click', function (e) {
				if (window.innerWidth <= 760) {
					e.preventDefault();
					dropdown.classList.toggle('open');
				}
			});
		}
	})();
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--paper);
		border-bottom: 2px solid var(--ink);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 0.7rem;
		padding-bottom: 0.7rem;
		flex-wrap: wrap;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		text-decoration: none;
		color: var(--ink);
	}
	.brand :global(.brand-mono) {
		font-size: 1.7rem;
	}
	.brand-name {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: 1.25rem;
		letter-spacing: -0.01em;
	}

	.menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 44px;
		height: 40px;
		padding: 0 8px;
		background: transparent;
		border: 2px solid var(--ink);
		cursor: pointer;
	}
	.menu-toggle span {
		display: block;
		height: 2px;
		background: var(--ink);
		transition: transform 0.2s ease, opacity 0.2s ease;
	}
	.site-header.nav-open .menu-toggle span:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}
	.site-header.nav-open .menu-toggle span:nth-child(2) {
		opacity: 0;
	}
	.site-header.nav-open .menu-toggle span:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	.nav {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		flex-wrap: wrap;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		text-transform: none;
		letter-spacing: 0.02em;
	}
	.nav > a {
		text-decoration: none;
		color: var(--ink);
		padding: 0.4rem 0.6rem;
	}
	.nav > a:hover {
		background: var(--ink);
		color: var(--paper);
	}
	.cta {
		background: var(--orange);
		color: var(--ink) !important;
		border: 2px solid var(--ink);
		font-weight: 700;
	}
	.cta:hover {
		background: var(--ink);
		color: var(--paper) !important;
	}

	.dropdown {
		position: relative;
	}
	.dropbtn {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		text-transform: none;
		letter-spacing: 0.02em;
		color: var(--ink);
		background: transparent;
		border: none;
		cursor: pointer;
		padding: 0.4rem 0.6rem;
	}
	.dropbtn:hover {
		background: var(--ink);
		color: var(--paper);
	}
	.dropdown-content {
		display: none;
		position: absolute;
		top: 100%;
		right: 0;
		background: var(--paper);
		min-width: 210px;
		border: 2px solid var(--ink);
		padding: 0.3rem;
		z-index: 110;
	}
	.dropdown:hover .dropdown-content {
		display: block;
	}
	.dropdown-content a {
		display: block;
		text-decoration: none;
		color: var(--ink);
		padding: 0.45rem 0.6rem;
		text-transform: none;
		letter-spacing: 0;
		font-size: 0.85rem;
	}
	.dropdown-content a:hover {
		background: var(--pink);
		color: var(--ink);
	}

	@media (max-width: 760px) {
		.menu-toggle {
			display: flex;
		}
		.nav {
			flex-basis: 100%;
			display: none;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 0.3rem 0 0.2rem;
			font-size: 0.95rem;
		}
		.site-header.nav-open .nav {
			display: flex;
		}
		.nav > a,
		.dropbtn {
			width: 100%;
			padding: 0.9rem 0.4rem;
			border-top: 1px solid var(--line);
			text-align: left;
			font-size: 0.95rem;
		}
		.cta {
			margin-top: 0.6rem;
			text-align: center;
			border: 2px solid var(--ink);
		}
		.dropdown {
			width: 100%;
		}
		.dropdown-content {
			position: static;
			border: none;
			min-width: 0;
			padding: 0 0 0.3rem 0.9rem;
			background: transparent;
		}
		.dropdown:hover .dropdown-content {
			display: none;
		}
		.dropdown.open .dropdown-content {
			display: block;
		}
		.dropdown-content a {
			font-size: 0.9rem;
			padding: 0.55rem 0.4rem;
		}
	}
</style>
