---
import FormattedDate from './FormattedDate.astro';
import { getOptimizedImageUrl, getResponsiveSrcSet } from '../utils/images';

const DEFAULT_COVER = '/default-cover.svg';
const { post } = Astro.props;
const { title, date, author, category, heroImage, imagePosition = 'center' } = post.data;

const cardImgSrc = getOptimizedImageUrl(heroImage, {
	width: 600,
	height: 400,
	crop: 'fill',
	quality: 'auto:good',
});
const cardSrcSet = getResponsiveSrcSet(heroImage, [360, 480, 640], 3 / 2);
---

<a class="card" href={`/blog/${post.id}/`}>
	<div class="card-photo">
		<img
			class="at-duotone"
			src={cardImgSrc}
			srcset={cardSrcSet}
			sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 380px"
			alt={title}
			loading="lazy"
			decoding="async"
			width="600"
			height="400"
			style={`object-position: ${imagePosition || 'center'};`}
		/>
		{category && <span class="at-tag">{category}</span>}
	</div>
	<div class="card-body">
		<h3 class="card-title">{title}</h3>
		<p class="card-meta">
			<FormattedDate date={date} />
			{author && <span> — {author}</span>}
		</p>
	</div>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: var(--ink);
		border: 2px solid var(--ink);
		background: var(--paper);
		box-shadow: 3px 3px 0 var(--ink);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.card:hover {
		transform: translate(-1px, -1px);
		box-shadow: 5px 5px 0 var(--ink);
	}
	.card-photo {
		position: relative;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		border-bottom: 2px solid var(--ink);
		background: var(--paper-2);
	}
	.card-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.5s ease;
	}
	.card:hover .card-photo img {
		transform: scale(1.03);
	}
	.card-photo .at-tag {
		position: absolute;
		top: 12px;
		left: 12px;
	}
	.card-body {
		padding: 1rem 1.15rem 1.25rem;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}
	.card-title {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.4rem;
		line-height: 1.1;
		margin: 0 0 0.5rem;
	}
	.card:hover .card-title {
		color: var(--pink);
	}
	.card-meta {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--muted);
		margin-top: auto;
		margin-bottom: 0;
	}
</style>
