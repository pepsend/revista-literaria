---
import FormattedDate from './FormattedDate.astro';

const DEFAULT_COVER = '/default-cover.svg';
const { post } = Astro.props;
const { title, date, author, category, heroImage } = post.data;
---

<a class="card" href={`/blog/${post.id}/`}>
	<div class="card-photo">
		<img class="at-duotone" src={heroImage || DEFAULT_COVER} alt={title} loading="lazy" />
		{category && <span class="at-tag">{category}</span>}
	</div>
	<div class="card-body">
		<h3 class="card-title">{title}</h3>
		<p class="card-meta">
			<FormattedDate date={date} />
			{author && <span> — {author}</span>}
		</p>
	</div>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: var(--ink);
		border: 2px solid var(--ink);
		background: var(--paper);
	}
	.card-photo {
		position: relative;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		border-bottom: 2px solid var(--ink);
	}
	.card-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.5s ease;
	}
	.card:hover .card-photo img {
		transform: scale(1.05);
	}
	.card-photo .at-tag {
		position: absolute;
		top: 12px;
		left: -8px;
	}
	.card-body {
		padding: 1rem 1.15rem 1.25rem;
	}
	.card-title {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: 1.45rem;
		line-height: 1.08;
		margin: 0 0 0.5rem;
	}
	.card:hover .card-title {
		color: var(--pink);
	}
	.card-meta {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--muted);
		margin: 0;
	}
</style>
