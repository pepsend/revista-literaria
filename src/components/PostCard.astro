---
import FormattedDate from './FormattedDate.astro';

const DEFAULT_COVER = '/default-cover.svg';
const { post } = Astro.props;
const { title, date, author, category, heroImage } = post.data;
---

<a class="post-card" href={`/blog/${post.id}/`}>
	<div class="thumb">
		<img src={heroImage || DEFAULT_COVER} alt={title} loading="lazy" />
	</div>
	<div class="body">
		{category && <span class="cat">{category}</span>}
		<h3 class="title">{title}</h3>
		<p class="meta">
			<FormattedDate date={date} />
			{author && <span> · {author}</span>}
		</p>
	</div>
</a>

<style>
	.post-card {
		display: flex;
		flex-direction: column;
		background: #fffdf9;
		border: 1px solid #ece4d5;
		border-radius: 14px;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		box-shadow: 0 4px 14px rgba(26, 25, 24, 0.06);
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}
	.post-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 16px 32px rgba(26, 25, 24, 0.13);
	}

	.thumb {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: #efe7db;
	}
	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.45s ease;
	}
	.post-card:hover .thumb img {
		transform: scale(1.04);
	}

	.body {
		padding: 1rem 1.15rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}
	.cat {
		align-self: flex-start;
		background: #f4e7dd;
		color: #b34a22;
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: 0.28rem 0.62rem;
		border-radius: 999px;
	}
	.title {
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 1.32rem;
		line-height: 1.25;
		font-weight: 700;
		color: #1a1918;
		margin: 0;
	}
	.post-card:hover .title {
		color: #b34a22;
	}
	.meta {
		font-size: 0.82rem;
		color: #8a8175;
		margin: 0;
	}
</style>
