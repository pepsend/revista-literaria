---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	<p class="brand">{SITE_TITLE}</p>
	<p class="tagline">revista literaria · ensayo, crítica y creación</p>
	<nav class="links">
		<a href="/novedades">Novedades</a>
		<a href="/linea-editorial">Línea editorial</a>
		<a href="/manifiesto">Manifiesto</a>
		<a href="/colaborar">Colaborar</a>
		<a href="/contacto">Contáctanos</a>
	</nav>
	<p class="copy">© {today.getFullYear()} {SITE_TITLE}. Todos los derechos reservados.</p>
</footer>

<style>
	footer {
		border-top: 1px solid #e2dbce;
		padding: 2.5rem 1.5rem 3rem;
		text-align: center;
		background: #f5f0e6;
	}
	.brand {
		font-family: Georgia, 'Times New Roman', serif;
		font-weight: 700;
		font-size: 1.3rem;
		text-transform: lowercase;
		color: #1a1918;
		margin: 0 0 0.2rem;
	}
	.tagline {
		font-size: 0.85rem;
		color: #8a8175;
		margin: 0 0 1.2rem;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.25rem 1.25rem;
		margin-bottom: 1.2rem;
	}
	.links a {
		color: #4a453e;
		text-decoration: none;
		font-size: 0.88rem;
	}
	.links a:hover {
		color: #b34a22;
	}
	.copy {
		font-size: 0.78rem;
		color: #a49a8c;
		margin: 0;
	}
</style>
