---
import Wordmark from './Wordmark.astro';
const today = new Date();
---

<footer class="site-footer">
	<div class="at-container">
		<div class="foot-sub">
			<div class="foot-sub-copy">
				<p class="foot-sub-label">// suscríbete</p>
				<p class="foot-sub-lead">te avisamos cuando publicamos algo nuevo. sin spam.</p>
			</div>
			<form
				id="sub-form"
				name="suscripcion"
				method="POST"
				action="/gracias/"
				data-netlify="true"
				netlify-honeypot="bot-field"
				class="foot-sub-form"
			>
				<input type="hidden" name="form-name" value="suscripcion" />
				<p class="foot-hp" hidden>
					<label>No llenar: <input name="bot-field" /></label>
				</p>
				<input
					type="email"
					name="email"
					required
					placeholder="tu@correo.com"
					aria-label="Tu correo"
				/>
				<button type="submit">suscribirme</button>
			</form>
			<p id="sub-msg" class="foot-sub-msg" hidden>// listo — te avisaremos cuando salga algo</p>
		</div>

		<div class="foot-top">
			<a class="foot-brand" href="/"><Wordmark /></a>
			<nav class="foot-nav">
				<a href="/novedades">novedades</a>
				<a href="/linea-editorial">línea editorial</a>
				<a href="/manifiesto">manifiesto</a>
				<a href="/colaborar">colaborar</a>
				<a href="/autores">autores</a>
				<a href="/contacto">contáctanos</a>
				<a href="/rss.xml" target="_blank" rel="noopener noreferrer">rss</a>
				<a
					class="foot-ig"
					href="https://instagram.com/abuliaterminal"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Instagram de abulia terminal"
				>
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
				</a>
			</nav>
		</div>
		<div class="foot-bottom">
			<span class="copy">abulia terminal © {today.getFullYear()}</span>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 2px solid var(--ink);
		margin-top: 2rem;
		padding: 2rem 0 2.5rem;
	}
	.foot-top {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap;
		padding-bottom: 1.5rem;
	}
	.foot-brand {
		text-decoration: none;
		color: var(--ink);
		font-size: 1.7rem;
	}
	.foot-nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 1.1rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		text-transform: none;
		letter-spacing: 0.02em;
	}
	.foot-nav a {
		color: var(--ink);
		text-decoration: none;
	}
	.foot-nav a:hover {
		color: var(--pink);
	}
	.foot-nav a.foot-ig {
		display: inline-flex;
		align-items: center;
		color: var(--pink);
	}
	.foot-nav a.foot-ig:hover {
		color: var(--orange);
	}
	.foot-ig svg {
		display: block;
	}
	.foot-bottom {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		border-top: 1px solid var(--line);
		padding-top: 1rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted);
	}
	.foot-bottom .copy {
		color: var(--orange);
	}

	/* Banda de suscripción */
	.foot-sub {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.2rem 2rem;
		flex-wrap: wrap;
		padding-bottom: 1.6rem;
		margin-bottom: 1.2rem;
		border-bottom: 1px solid var(--line);
	}
	.foot-sub-copy {
		flex: 1 1 16rem;
		min-width: 0;
	}
	.foot-sub-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--pink);
		margin: 0 0 0.3rem;
	}
	.foot-sub-lead {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.05rem;
		line-height: 1.3;
		color: var(--ink);
		margin: 0;
	}
	.foot-sub-form {
		display: flex;
		gap: 0.5rem;
		flex: 1 1 20rem;
		min-width: 0;
	}
	.foot-sub-form input[type='email'] {
		flex: 1;
		min-width: 0;
		border: 2px solid var(--ink);
		background: var(--paper);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--ink);
		padding: 0.6rem 0.8rem;
		outline: none;
	}
	.foot-sub-form input[type='email']:focus {
		box-shadow: 3px 3px 0 var(--pink);
	}
	.foot-sub-form input::placeholder {
		color: var(--muted);
	}
	.foot-sub-form button {
		border: 2px solid var(--ink);
		background: var(--pink);
		color: var(--ink);
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 0.82rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 0.6rem 1rem;
		cursor: pointer;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}
	.foot-sub-form button:hover {
		box-shadow: 3px 3px 0 var(--ink);
		transform: translate(-1px, -1px);
	}
	.foot-sub-form button:disabled {
		opacity: 0.6;
		cursor: default;
	}
	.foot-sub-msg {
		flex: 1 1 100%;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--orange);
		margin: 0;
	}
	@media (max-width: 640px) {
		.foot-sub {
			align-items: stretch;
		}
		.foot-sub-form {
			flex-wrap: wrap;
		}
		.foot-sub-form button {
			flex: 1;
		}
	}
</style>

<script is:inline>
	(function () {
		var form = document.getElementById('sub-form');
		if (!form) return;
		form.addEventListener('submit', function (e) {
			e.preventDefault();
			var btn = form.querySelector('button[type="submit"]');
			if (btn) {
				btn.disabled = true;
				btn.textContent = 'enviando…';
			}
			fetch('/', { method: 'POST', body: new FormData(form) })
				.then(done)
				.catch(done);
		});
		function done() {
			form.style.display = 'none';
			var m = document.getElementById('sub-msg');
			if (m) m.hidden = false;
		}
	})();
</script>
