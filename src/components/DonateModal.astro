		}

		.donate-title {
			font-size: 1.25rem;
		}

		.donate-mp-btn {
			flex-direction: column;
			gap: 0.4rem;
			padding: 0.85rem 0.6rem;
		}

		.donate-tef-list li {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.1rem;
		}

		.tef-val {
