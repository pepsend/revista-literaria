---
// Componente de donaciones / aportes para Abulia Terminal
// Pasarela: Mercado Pago (link.mercadopago.cl/abuliaterminal)
// Cuenta de destino TEF: Tomás Ignacio Ragga Sepúlveda (Cuenta Vista Mercado Pago)
---

<dialog id="donate-modal" class="donate-dialog" aria-labelledby="donate-dialog-title" aria-modal="true">
	<div class="donate-dialog-inner">
		<!-- Cabecera modal -->
		<div class="donate-head">
			<div class="donate-head-meta">
				<span class="at-kicker">// aporte voluntario</span>
				<h2 id="donate-dialog-title" class="donate-title">apoyar a abulia terminal</h2>
			</div>
			<button type="button" class="donate-close" id="donate-close-btn" aria-label="Cerrar ventana">
				<span aria-hidden="true">✕</span>
			</button>
		</div>

		<hr class="at-rule donate-rule" />

		<!-- Mensaje editorial -->
		<p class="donate-lead">
			somos una revista literaria independiente y autogestionada. tu aporte nos permite financiar
			servidores, dominio y retribuir las colaboraciones de autores y editores.
		</p>

		<!-- BLOQUE 1: PAGO ONLINE DIRECTO CON MERCADO PAGO -->
		<div class="donate-mp-box">
			<div class="donate-mp-top">
				<div class="donate-mp-badge-wrap">
					<img
						src="/mercadopago.png"
						alt="Mercado Pago"
						width="125"
						height="32"
						class="donate-mp-logo"
						loading="eager"
					/>
				</div>
				<span class="donate-mp-pill">link oficial</span>
			</div>

			<p class="donate-mp-desc">
				aporta con un clic usando tu <strong>saldo de Mercado Pago</strong>, tarjeta de <strong>débito (Redcompra / Webpay)</strong> o <strong>crédito</strong>:
			</p>

			<a
				href="https://link.mercadopago.cl/abuliaterminal"
				target="_blank"
				rel="noopener noreferrer"
				class="donate-mp-cta"
				title="Abrir checkout seguro en Mercado Pago"
			>
				<span class="donate-mp-cta-label">donar con Mercado Pago ↗</span>
				<span class="donate-mp-cta-url">link.mercadopago.cl/abuliaterminal</span>
			</a>
		</div>

		<!-- Divisor de opciones -->
		<div class="donate-sep">
			<span class="donate-sep-line"></span>
			<span class="donate-sep-text">// o mediante transferencia electrónica directa</span>
			<span class="donate-sep-line"></span>
		</div>

		<!-- BLOQUE 2: FICHA DE DATOS BANCARIOS (TEF sin comisión) -->
		<div class="donate-card">
			<div class="donate-card-header">
				<span class="donate-card-tag">Mercado Pago · Cuenta Vista</span>
				<span class="donate-card-tef">0% comisiones</span>
			</div>

			<dl class="donate-fields">
				<div class="donate-field">
					<dt>Titular</dt>
					<dd class="donate-val">
						<span class="donate-text">Tomás Ignacio Ragga Sepúlveda</span>
					</dd>
				</div>

				<div class="donate-field">
					<dt>RUT</dt>
					<dd class="donate-val">
						<code class="donate-code">20.638.381-K</code>
						<button
							type="button"
							class="donate-copy-btn"
							data-copy="20638381K"
							aria-label="Copiar RUT"
							title="Copiar RUT sin puntos ni guion"
						>
							copiar
						</button>
					</dd>
				</div>

				<div class="donate-field">
					<dt>Banco / Institución</dt>
					<dd class="donate-val">
						<span class="donate-text">Mercado Pago</span>
						<span class="donate-hint">(Mercado Pago Emisora S.A.)</span>
					</dd>
				</div>

				<div class="donate-field">
					<dt>Tipo de cuenta</dt>
					<dd class="donate-val">
						<span class="donate-text">Cuenta Vista</span>
					</dd>
				</div>

				<div class="donate-field">
					<dt>N° de cuenta</dt>
					<dd class="donate-val">
						<code class="donate-code">1055093009</code>
						<button
							type="button"
							class="donate-copy-btn"
							data-copy="1055093009"
							aria-label="Copiar número de cuenta"
							title="Copiar número de cuenta"
						>
							copiar
						</button>
					</dd>
				</div>

				<div class="donate-field">
					<dt>Correo</dt>
					<dd class="donate-val">
						<code class="donate-code">t.traggas@gmail.com</code>
						<button
							type="button"
							class="donate-copy-btn"
							data-copy="t.traggas@gmail.com"
							aria-label="Copiar correo electrónico"
							title="Copiar correo"
						>
							copiar
						</button>
					</dd>
				</div>
			</dl>

			<!-- Botón para copiar todos los datos juntos -->
			<button
				type="button"
				class="donate-copy-all-btn"
				id="donate-copy-all-btn"
				title="Copiar todos los datos de transferencia para tu aplicación bancaria"
			>
				<svg class="donate-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
					<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
				</svg>
				<span class="donate-copy-all-label">copiar todos los datos para transferir</span>
			</button>
		</div>

		<!-- Mensaje de confirmación accesible -->
		<p id="donate-status" class="donate-status" role="status" aria-live="polite"></p>

		<!-- Garantías de seguridad -->
		<div class="donate-security">
			<span class="donate-lock-icon" aria-hidden="true">🔒</span>
			<p>
				<strong>Plataforma segura:</strong> los pagos online son procesados directamente por la infraestructura oficial de Mercado Pago con cifrado SSL. También puedes transferir desde cualquier banco de Chile seleccionando <em>Mercado Pago</em> como institución de destino.
			</p>
		</div>
	</div>
</dialog>

<script is:inline>
	(function () {
		var modal = document.getElementById('donate-modal');
		if (!modal) return;

		var closeBtn = document.getElementById('donate-close-btn');
		var copyAllBtn = document.getElementById('donate-copy-all-btn');
		var statusEl = document.getElementById('donate-status');
		var statusTimer = null;

		var ALL_DATA_TEXT = [
			'Titular: Tomás Ignacio Ragga Sepúlveda',
			'RUT: 20.638.381-K',
			'Banco: Mercado Pago',
			'Tipo de cuenta: Cuenta Vista',
			'N° de cuenta: 1055093009',
			'Correo: t.traggas@gmail.com',
			'Asunto: Aporte Abulia Terminal'
		].join('\n');

		function showStatus(msg) {
			if (!statusEl) return;
			statusEl.textContent = msg;
			statusEl.classList.add('is-visible');
			if (statusTimer) clearTimeout(statusTimer);
			statusTimer = setTimeout(function () {
				statusEl.textContent = '';
				statusEl.classList.remove('is-visible');
			}, 3500);
		}

		function copyToClipboard(text, onSuccess) {
			if (navigator.clipboard && window.isSecureContext) {
				navigator.clipboard.writeText(text).then(function () {
					if (onSuccess) onSuccess();
				}).catch(function () {
					fallbackCopy(text, onSuccess);
				});
			} else {
				fallbackCopy(text, onSuccess);
			}
		}

		function fallbackCopy(text, onSuccess) {
			try {
				var ta = document.createElement('textarea');
				ta.value = text;
				ta.style.position = 'fixed';
				ta.style.left = '-9999px';
				ta.style.top = '-9999px';
				document.body.appendChild(ta);
				ta.focus();
				ta.select();
				var ok = document.execCommand('copy');
				document.body.removeChild(ta);
				if (ok && onSuccess) onSuccess();
			} catch (err) {
				showStatus('Por favor copia los datos manualmente.');
			}
		}

		function openModal() {
			if (typeof modal.showModal === 'function') {
				modal.showModal();
			} else {
				modal.setAttribute('open', '');
			}
			document.body.style.overflow = 'hidden';
		}

		function closeModal() {
			if (typeof modal.close === 'function') {
				modal.close();
			} else {
				modal.removeAttribute('open');
			}
			document.body.style.overflow = '';
		}

		// Delegación global: cualquier elemento con data-open-donate abre el modal
		document.addEventListener('click', function (e) {
			var trigger = e.target && e.target.closest ? e.target.closest('[data-open-donate]') : null;
			if (trigger) {
				e.preventDefault();
				openModal();
			}
		});

		// Cerrar al hacer clic en el botón de cierre
		if (closeBtn) {
			closeBtn.addEventListener('click', function () {
				closeModal();
			});
		}

		// Cerrar al hacer clic en el backdrop
		modal.addEventListener('click', function (e) {
			if (e.target === modal) {
				closeModal();
			}
		});

		// Restaurar scroll si se cierra con Esc
		modal.addEventListener('cancel', function () {
			document.body.style.overflow = '';
		});
		modal.addEventListener('close', function () {
			document.body.style.overflow = '';
		});

		// Copiar campo individual
		var copyButtons = modal.querySelectorAll('[data-copy]');
		copyButtons.forEach(function (btn) {
			btn.addEventListener('click', function () {
				var val = btn.getAttribute('data-copy');
				if (!val) return;
				copyToClipboard(val, function () {
					var original = btn.textContent;
					btn.textContent = '✓';
					btn.classList.add('is-copied');
					showStatus('✓ Copiado al portapapeles: ' + val);
					setTimeout(function () {
						btn.textContent = original;
						btn.classList.remove('is-copied');
					}, 2000);
				});
			});
		});

		// Copiar todos los datos de transferencia juntos
		if (copyAllBtn) {
			copyAllBtn.addEventListener('click', function () {
				copyToClipboard(ALL_DATA_TEXT, function () {
					var lbl = copyAllBtn.querySelector('.donate-copy-all-label');
					var origText = lbl ? lbl.textContent : 'copiar todos los datos para transferir';
					if (lbl) lbl.textContent = '✓ ¡datos copiados al portapapeles!';
					copyAllBtn.classList.add('is-copied');
					showStatus('✓ Datos listos para pegar en tu app bancaria.');
					setTimeout(function () {
						if (lbl) lbl.textContent = origText;
						copyAllBtn.classList.remove('is-copied');
					}, 2500);
				});
			});
		}
	})();
</script>

