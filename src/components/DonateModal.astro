		color: var(--muted);
	}

	/* 2. FICHA DE DATOS DE TRANSFERENCIA */
	.donate-tef-card {
		border: 1.5px solid var(--ink);
		background: var(--paper-2);
		padding: 0.9rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.donate-tef-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.81rem;
	}

	.donate-tef-list li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.5rem;
		border-bottom: 1px dotted var(--line);
		padding-bottom: 0.25rem;
	}

	.donate-tef-list li:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.tef-label {
		color: var(--muted);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.tef-val {
		font-weight: 700;
		color: var(--ink);
		text-align: right;
		word-break: break-all;
	}

	.donate-copy-btn {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		background: var(--paper);
		color: var(--ink);
		border: 1.5px solid var(--ink);
		padding: 0.6rem 0.8rem;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		width: 100%;
		transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
	}

	.donate-copy-btn:hover {
		background: var(--ink);
