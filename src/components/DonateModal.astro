---
// Componente de donaciones para Abulia Terminal
// Pasarela online: Mercado Pago (link.mercadopago.cl/abuliaterminal)
// Transferencia: Cuenta Vista Mercado Pago (Tomás Ignacio Ragga Sepúlveda)
---

<dialog id="donate-modal" class="donate-dialog" aria-labelledby="donate-dialog-title" aria-modal="true">
	<div class="donate-dialog-inner">
		<!-- Cabecera -->
		<div class="donate-head">
			<div class="donate-head-meta">
				<span class="at-kicker">aporte voluntario</span>
				<h2 id="donate-dialog-title" class="donate-title">apoyar a abulia terminal</h2>
			</div>
			<button type="button" class="donate-close" id="donate-close-btn" aria-label="Cerrar ventana">
				<span aria-hidden="true">✕</span>
			</button>
		</div>

		<hr class="at-rule donate-rule" />

		<!-- Mensaje breve -->
		<p class="donate-lead">
			revista literaria independiente y autogestionada. tu aporte voluntario nos ayuda directamente a pagar infraestructura (servidores, dominio) y mantener en pie este proyecto.
		</p>

		<!-- 1. PAGO ONLINE CON MERCADO PAGO -->
		<div class="donate-section">
			<a
				href="https://link.mercadopago.cl/abuliaterminal"
				target="_blank"
				rel="noopener noreferrer"
				class="donate-mp-btn"
				title="Pagar online con Mercado Pago"
			>
				<span class="donate-mp-logo-pill">
					<img
						src="/mercadopago.png"
						alt="Mercado Pago"
						width="112"
						height="29"
						class="donate-mp-img"
						loading="eager"
					/>
				</span>
				<span class="donate-mp-label">donar con Mercado Pago ↗</span>
			</a>
			<p class="donate-mp-hint">saldo en cuenta, débito (Redcompra / Webpay) o crédito</p>
		</div>

		<!-- Separador sutil -->
		<div class="donate-divider">
			<span>o transferencia bancaria directa</span>
		</div>

		<!-- 2. DATOS DE TRANSFERENCIA (LIMPIOS Y MINIMALISTAS) -->
		<div class="donate-tef-card">
			<ul class="donate-tef-list">
				<li><span class="tef-label">Titular:</span> <span class="tef-val">Tomás Ignacio Ragga Sepúlveda</span></li>
				<li><span class="tef-label">RUT:</span> <span class="tef-val">20.638.381-K</span></li>
				<li><span class="tef-label">Banco:</span> <span class="tef-val">Mercado Pago</span></li>
				<li><span class="tef-label">Tipo:</span> <span class="tef-val">Cuenta Vista</span></li>
				<li><span class="tef-label">N° de cuenta:</span> <span class="tef-val">1055093009</span></li>
				<li><span class="tef-label">Correo:</span> <span class="tef-val">t.traggas@gmail.com</span></li>
			</ul>

			<button
				type="button"
				class="donate-copy-btn"
				id="donate-copy-all-btn"
				title="Copiar datos para tu app bancaria"
			>
				<svg class="donate-copy-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
					<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
				</svg>
				<span class="donate-copy-text">copiar datos de transferencia</span>
			</button>
		</div>

		<!-- Nota final minimalista -->
		<p class="donate-foot-note">
			🔒 Transferible desde cualquier banco chileno o directamente desde la app de Mercado Pago.
		</p>
	</div>
</dialog>

<script is:inline>
	(function () {
		var modal = document.getElementById('donate-modal');
		if (!modal) return;

		var closeBtn = document.getElementById('donate-close-btn');
		var copyBtn = document.getElementById('donate-copy-all-btn');

		var TEF_DATA = [
			'Titular: Tomás Ignacio Ragga Sepúlveda',
			'RUT: 20.638.381-K',
			'Banco: Mercado Pago',
			'Tipo: Cuenta Vista',
			'N° de cuenta: 1055093009',
			'Correo: t.traggas@gmail.com',
			'Asunto: Donación Abulia Terminal'
		].join('\n');

		function copyToClipboard(text, onSuccess) {
			if (navigator.clipboard && window.isSecureContext) {
				navigator.clipboard.writeText(text).then(function () {
					if (onSuccess) onSuccess();
				}).catch(function () {
					fallbackCopy(text, onSuccess);
				});
			} else {
				fallbackCopy(text, onSuccess);
			}
		}

		function fallbackCopy(text, onSuccess) {
			try {
				var ta = document.createElement('textarea');
				ta.value = text;
				ta.style.position = 'fixed';
				ta.style.left = '-9999px';
				ta.style.top = '-9999px';
				document.body.appendChild(ta);
				ta.focus();
				ta.select();
				var ok = document.execCommand('copy');
				document.body.removeChild(ta);
				if (ok && onSuccess) onSuccess();
			} catch (err) {}
		}

		function openModal() {
			if (typeof modal.showModal === 'function') {
				modal.showModal();
			} else {
				modal.setAttribute('open', '');
			}
			document.body.style.overflow = 'hidden';
		}

		function closeModal() {
			if (typeof modal.close === 'function') {
				modal.close();
			} else {
				modal.removeAttribute('open');
			}
			document.body.style.overflow = '';
		}

		// Delegación global: cualquier botón con data-open-donate abre el modal
		document.addEventListener('click', function (e) {
			var trigger = e.target && e.target.closest ? e.target.closest('[data-open-donate]') : null;
			if (trigger) {
				e.preventDefault();
				openModal();
			}
		});

		if (closeBtn) {
			closeBtn.addEventListener('click', closeModal);
		}

		modal.addEventListener('click', function (e) {
			if (e.target === modal) {
				closeModal();
			}
		});

		modal.addEventListener('cancel', function () {
			document.body.style.overflow = '';
		});
		modal.addEventListener('close', function () {
			document.body.style.overflow = '';
		});

		// Copiar datos de transferencia
		if (copyBtn) {
			copyBtn.addEventListener('click', function () {
				copyToClipboard(TEF_DATA, function () {
					var textEl = copyBtn.querySelector('.donate-copy-text');
					var orig = textEl ? textEl.textContent : 'copiar datos de transferencia';
					if (textEl) textEl.textContent = '✓ ¡datos copiados al portapapeles!';
					copyBtn.classList.add('is-copied');
					setTimeout(function () {
						if (textEl) textEl.textContent = orig;
						copyBtn.classList.remove('is-copied');
					}, 2500);
				});
			});
		}
	})();
</script>

<style>
	/* Diálogo modal */
	.donate-dialog {
		margin: auto;
		padding: 0;
		border: 2px solid var(--ink);
		background: var(--paper);
		color: var(--ink);
		width: min(480px, calc(100vw - 2rem));
		max-height: 90vh;
		overflow-y: auto;
		box-shadow: 6px 6px 0 var(--ink);
	}

	.donate-dialog::backdrop {
		background: rgba(19, 18, 17, 0.78);
		backdrop-filter: blur(3px);
		-webkit-backdrop-filter: blur(3px);
	}

	.donate-dialog-inner {
		padding: 1.5rem 1.6rem;
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}

	.donate-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
	}

	.donate-head-meta {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.donate-title {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: 1.4rem;
		line-height: 1.15;
		margin: 0;
		color: var(--ink);
		letter-spacing: -0.01em;
	}

	.donate-close {
		background: transparent;
		border: 1.5px solid var(--ink);
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: 1.1rem;
		line-height: 1;
		width: 34px;
		height: 34px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		flex-shrink: 0;
		transition: background 0.15s ease, color 0.15s ease;
	}

	.donate-close:hover {
		background: var(--ink);
		color: var(--paper);
	}

	.donate-lead {
		font-family: var(--font-mono);
		font-size: 0.83rem;
		line-height: 1.5;
		color: var(--text-soft);
		margin: 0;
	}

	/* 1. SECCIÓN PAGO ONLINE MERCADO PAGO */
	.donate-section {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.donate-mp-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		text-decoration: none;
		background: #009ee3;
		color: #ffffff !important;
		border: 2px solid var(--ink);
		padding: 0.75rem 1rem;
		cursor: pointer;
		font-family: var(--font-mono);
		font-size: 0.88rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		box-shadow: 3px 3px 0 var(--ink);
		transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
	}

	.donate-mp-btn:hover {
		background: #007eb5;
		transform: translate(-1px, -1px);
		box-shadow: 4px 4px 0 var(--ink);
	}

	.donate-mp-logo-pill {
		background: #ffffff;
		border: 1px solid var(--ink);
		padding: 2px 7px;
		border-radius: 3px;
		display: inline-flex;
		align-items: center;
	}

	.donate-mp-img {
		display: block;
		height: auto;
		max-width: 100px;
	}

	.donate-mp-hint {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--muted);
		text-align: center;
		margin: 0;
	}

	/* Separador */
	.donate-divider {
		display: flex;
		align-items: center;
		text-align: center;
		margin: 0.1rem 0;
	}

	.donate-divider::before,
	.donate-divider::after {
		content: '';
		flex: 1;
		border-bottom: 1px solid var(--line);
	}

	.donate-divider span {
		padding: 0 0.6rem;
