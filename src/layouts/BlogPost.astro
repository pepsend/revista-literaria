---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import { categorySlug } from '../content.config';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type CardData = {
	slug: string;
	title: string;
	category: string | null;
	date: Date;
	heroImage: string | null;
	imagePosition: string;
};
type Props = CollectionEntry<'posts'>['data'] & {
	newer?: CardData | null;
	older?: CardData | null;
	related?: (CardData | null)[];
	readingMinutes?: number;
};

const DEFAULT_COVER = '/default-cover.svg';
const {
	title,
	date,
	author,
	category,
	heroImage,
	imagePosition = 'center',
	authorBio,
	citations,
	justify = true,
	tags = [],
	newer = null,
	older = null,
	related = [],
	readingMinutes,
} = Astro.props;

// Relacionados válidos (descarta posibles nulos por seguridad).
const relatedCards = (related || []).filter(Boolean) as CardData[];

// URL canónica del texto para los botones de compartir.
const shareUrl = new URL(Astro.url.pathname, Astro.site).href;
const waHref = `https://wa.me/?text=${encodeURIComponent(`${title} — ${shareUrl}`)}`;
const xHref = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(shareUrl)}`;

// Imagen absoluta para OG / datos estructurados.
const ogAbs = heroImage
	? heroImage.startsWith('http')
		? heroImage
		: new URL(heroImage, Astro.site).href
	: undefined;

// Tarjeta OG: dibuja el título sobre la foto (solo si el hero está en Cloudinary).
// Para textos futuros funciona automáticamente; si el hero no es de Cloudinary,
// se usa la imagen tal cual (fallback).
const buildOgCard = (url: string, t: string): string | null => {
	const marker = '/image/upload/';
	const idx = url.indexOf(marker);
	if (idx === -1 || !url.includes('res.cloudinary.com')) return null;
	const before = url.slice(0, idx + marker.length);
	const after = url.slice(idx + marker.length);
	const txt = encodeURIComponent(t);
	const transform = `w_1200,h_630,c_fill,g_auto/e_brightness:-30/co_rgb:f2e4cc,l_text:Georgia_72_bold:${txt},g_south_west,x_72,y_96,w_1056,c_fit`;
	return `${before}${transform}/${after}`;
};
const ogCard = heroImage ? buildOgCard(heroImage, title) : null;

// Datos estructurados (schema.org Article) para buscadores y redes.
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	datePublished: date.toISOString(),
	dateModified: date.toISOString(),
	inLanguage: 'es',
	mainEntityOfPage: { '@type': 'WebPage', '@id': shareUrl },
	publisher: { '@type': 'Organization', name: 'abulia terminal' },
	...(author ? { author: { '@type': 'Person', name: author } } : {}),
	...(ogAbs ? { image: [ogAbs] } : {}),
	...(category ? { articleSection: category } : {}),
};

// Bio del autor escrita en este artículo (una o más líneas → párrafos).
const postBioLines = (authorBio || '')
	.split(/\r?\n+/)
	.map((s) => s.trim())
	.filter(Boolean);

// Obras citadas: una entrada por línea.
const citationLines = (citations || '')
	.split(/\r?\n+/)
	.map((s) => s.trim())
	.filter(Boolean);

// Bio del autor: se toma de la colección "authors" y se muestra al final del texto.
const authorsList = await getCollection('authors');
const authorEntry = author
	? authorsList.find((a) => a.data.name.trim() === author.trim())
	: undefined;
const AuthorBio =
	authorEntry && authorEntry.body && authorEntry.body.trim()
		? (await render(authorEntry)).Content
		: null;
---

<html lang="es">
	<head>
		<BaseHead
			title={title}
			description={category ? `${category} — ${title}` : title}
			ogImage={ogCard ?? heroImage}
			type="article"
			publishedTime={date.toISOString()}
			authorName={author}
			section={category}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	</head>
	<body>
		<Header />
		<main class="article at-container">
			<a class="back" href="/">← índice</a>

			<header class="art-head">
				{category && <span class="at-tag">{category}</span>}
				<h1 class="art-title">{title}</h1>
				<p class="art-meta">
					{author && (
						<a class="meta-author" href={`/autores/${categorySlug(author)}/`}>
							{author}
						</a>
					)}
					{author && ' — '}
					<FormattedDate date={date} />
					{readingMinutes && <span class="art-rt"> · {readingMinutes} min de lectura</span>}
				</p>
			</header>

			<div class="art-hero">
				<img
					class="at-duotone"
					src={heroImage || DEFAULT_COVER}
					alt={title}
					width="1600"
					height="900"
					style={`object-position: ${imagePosition};`}
				/>
			</div>

			<article class:list={['prose', { 'prose--justify': justify }]}>
				<slot />
			</article>

			{
				tags.length > 0 && (
					<section class="art-tags">
						<span class="art-tags-label">// etiquetas</span>
						<span class="art-tags-list">
							{tags.map((t) => (
								<a class="tag-chip" href={`/tags/${categorySlug(t.trim())}/`}>
									#{t.trim()}
								</a>
							))}
						</span>
					</section>
				)
			}

			<section class="art-share">
				<span class="art-share-label">// compartir</span>
				<div class="art-share-btns">
					<a class="share-btn" href={waHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
					<a class="share-btn" href={xHref} target="_blank" rel="noopener noreferrer">X</a>
					<button class="share-btn" type="button" id="copy-link" data-url={shareUrl}>
						copiar enlace
					</button>
				</div>
			</section>

			{
				(postBioLines.length > 0 || AuthorBio) && (
					<aside class="art-author">
						<p class="art-author-label">// sobre el autor</p>
						{author && (
							<p class="art-author-name">
								<a href={`/autores/${categorySlug(author)}/`}>{author}</a>
							</p>
						)}
						<div class="art-author-bio">
							{postBioLines.length > 0 ? postBioLines.map((p) => <p>{p}</p>) : <AuthorBio />}
						</div>
					</aside>
				)
			}

			{
				citationLines.length > 0 && (
					<section class="art-cites">
						<p class="art-cites-label">// obras citadas</p>
						<ul class="art-cites-list">
							{citationLines.map((c) => (
								<li class="art-cites-item">{c}</li>
							))}
						</ul>
					</section>
				)
			}

			<p class="art-end">// fin del texto</p>

			{
				relatedCards.length > 0 && (
					<section class="art-related">
						<p class="art-related-label">// seguir leyendo</p>
						<div class="art-related-grid">
							{relatedCards.map((r) => (
								<a class="rel-card" href={`/blog/${r.slug}/`}>
									<span class="rel-thumb">
										<img
											class="at-duotone"
											src={r.heroImage || DEFAULT_COVER}
											alt={r.title}
											loading="lazy"
											width="300"
											height="200"
											style={`object-position: ${r.imagePosition};`}
										/>
									</span>
									<span class="rel-body">
										{r.category && <span class="rel-cat">{r.category}</span>}
										<span class="rel-title">{r.title}</span>
										<span class="rel-date">
											<FormattedDate date={r.date} />
										</span>
									</span>
								</a>
							))}
						</div>
					</section>
				)
			}

			{
				(older || newer) && (
					<nav class="art-nav" aria-label="Navegación entre textos">
						{older ? (
							<a class="art-nav-link prev" href={`/blog/${older.slug}/`}>
								<span class="art-nav-dir">← más antigua</span>
								<span class="art-nav-title">{older.title}</span>
							</a>
						) : (
							<span class="art-nav-empty" />
						)}
						{newer ? (
							<a class="art-nav-link next" href={`/blog/${newer.slug}/`}>
								<span class="art-nav-dir">más reciente →</span>
								<span class="art-nav-title">{newer.title}</span>
							</a>
						) : (
							<span class="art-nav-empty" />
						)}
					</nav>
				)
			}
		</main>
		<button id="to-top" class="to-top" type="button" aria-label="Volver arriba">↑</button>
		<Footer />
		<script is:inline>
			(function () {
				// Copiar enlace del texto
				var copyBtn = document.getElementById('copy-link');
				if (copyBtn) {
					copyBtn.addEventListener('click', function () {
						var url = copyBtn.getAttribute('data-url') || location.href;
						var done = function () {
							copyBtn.textContent = '¡copiado!';
							setTimeout(function () {
								copyBtn.textContent = 'copiar enlace';
							}, 1600);
						};
						if (navigator.clipboard && navigator.clipboard.writeText) {
							navigator.clipboard.writeText(url).then(done).catch(done);
						} else {
							var ta = document.createElement('textarea');
							ta.value = url;
							document.body.appendChild(ta);
							ta.select();
							try {
								document.execCommand('copy');
							} catch (e) {}
							document.body.removeChild(ta);
							done();
						}
					});
				}
				// Volver arriba
				var toTop = document.getElementById('to-top');
				if (toTop) {
					var onScroll = function () {
						if (window.scrollY > 600) toTop.classList.add('show');
						else toTop.classList.remove('show');
					};
					window.addEventListener('scroll', onScroll, { passive: true });
					onScroll();
					toTop.addEventListener('click', function () {
						window.scrollTo({ top: 0, behavior: 'smooth' });
					});
				}
			})();
		</script>
	</body>
</html>

<style>
	.article {
		padding-top: 1.5rem;
		padding-bottom: 2rem;
	}
	.back {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted);
		text-decoration: none;
	}
	.back:hover {
		color: var(--pink);
	}
	.art-head {
		max-width: 46rem;
		margin: 1.5rem auto 0;
		text-align: center;
	}
	.art-title {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: clamp(2.2rem, 6vw, 4rem);
		line-height: 1.03;
		margin: 0.8rem 0 0.8rem;
	}
	.art-meta {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--muted);
		margin: 0;
	}
	.art-meta b {
		color: var(--ink);
	}
	.meta-author {
		color: var(--ink);
		font-weight: 700;
		text-decoration: none;
		border-bottom: 1px solid transparent;
	}
	.meta-author:hover {
		color: var(--pink);
		border-bottom-color: var(--pink);
	}
	.art-hero {
		max-width: 60rem;
		margin: 2rem auto 0;
	}
	.art-hero img {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		object-position: center;
		border: 2px solid var(--ink);
	}
	.prose {
		max-width: 40rem;
		margin: 2.5rem auto 0;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 1.18rem;
		line-height: 1.75;
		color: var(--text);
	}
	/* Justificado del cuerpo (interruptor por artículo). Solo párrafos:
	   los poemas del bloque «Texto alineado» conservan su alineación propia. */
	.prose--justify :global(p) {
		text-align: justify;
	}
	.prose :global(p) {
		margin: 0 0 1.3rem;
	}
	.prose :global(a) {
		color: var(--pink);
	}
	.prose :global(em) {
		font-style: italic;
	}
	.prose :global(strong),
	.prose :global(b) {
		font-weight: 900;
	}
	.prose :global(h2),
	.prose :global(h3) {
		font-weight: 900;
		line-height: 1.15;
		margin: 2rem 0 0.8rem;
	}
	.prose :global(blockquote) {
		border-left: 3px solid var(--pink);
		margin: 1.5rem 0;
		padding-left: 1.2rem;
		font-style: italic;
		color: var(--text-soft);
	}
	/* Imágenes dentro del cuerpo (entre párrafos) */
	.prose :global(img) {
		display: block;
		width: 100%;
		height: auto;
		margin: 1.8rem 0;
		border: 2px solid var(--ink);
	}
	.prose :global(figure) {
		margin: 1.8rem 0;
		max-width: 100%;
	}
	/* La imagen llena el ancho de la figura (el ancho/alineación se fijan inline). */
	.prose :global(figure img) {
		width: 100%;
		margin: 0;
	}
	.prose :global(figcaption) {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--muted);
		margin-top: 0.4rem;
		text-align: center;
	}
	/* Bloque de texto alineado (la alineación va inline). */
	.prose :global(.aln) {
		white-space: pre-wrap;
		margin: 2rem 0;
		line-height: 1.6;
		max-width: 100%;
		overflow-x: auto;
	}
	@media (max-width: 560px) {
		.prose :global(.aln) {
			font-size: 0.86rem;
			line-height: 1.5;
		}
	}

	/* Obras citadas — bloque distinto, on-brand, con sangría francesa */
	.art-cites {
		max-width: 40rem;
		margin: 3rem auto 0;
		padding: 1.2rem 1.5rem 1.4rem;
		border: 1px solid var(--ink);
		background: var(--paper-2);
	}
	.art-cites-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--pink);
		margin: 0 0 0.8rem;
	}
	.art-cites-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.art-cites-item {
		font-family: var(--font-display);
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--text-soft);
		padding-left: 1.5rem;
		text-indent: -1.5rem;
		margin: 0 0 0.6rem;
	}
	.art-cites-item:last-child {
		margin-bottom: 0;
	}

	/* Sobre el autor — panel oscuro (modo terminal) que sobresale del cuerpo */
	.art-author {
		max-width: 40rem;
		margin: 3rem auto 0;
		padding: 1.6rem 1.6rem 1.5rem;
		border: 2px solid var(--ink);
		background: var(--negro);
		color: var(--crema);
		box-shadow: 8px 8px 0 var(--pink);
	}
	.art-author-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--pink);
		margin: 0 0 0.5rem;
	}
	.art-author-name {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: 1.35rem;
		margin: 0 0 0.5rem;
		color: var(--crema);
	}
	.art-author-name a {
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid transparent;
	}
	.art-author-name a:hover {
		color: var(--pink);
		border-bottom-color: var(--pink);
	}
	.art-author-bio {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 1.02rem;
		line-height: 1.6;
		color: #d8ccb6;
	}
	.art-author-bio :global(p) {
		margin: 0 0 0.7rem;
	}
	.art-author-bio :global(p:last-child) {
		margin-bottom: 0;
	}
	.art-author-bio :global(a) {
		color: var(--pink);
	}
	.art-end {
		max-width: 40rem;
		margin: 2.5rem auto 0;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--muted);
	}
	.art-rt {
		color: var(--pink);
	}

	/* Seguir leyendo — relacionados */
	.art-related {
		max-width: 60rem;
		margin: 3.5rem auto 0;
	}
	.art-related-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--pink);
		margin: 0 0 1rem;
		border-top: 2px solid var(--ink);
		padding-top: 0.8rem;
	}
	.art-related-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.2rem;
	}
	.rel-card {
		display: flex;
		flex-direction: column;
		border: 2px solid var(--ink);
		background: var(--paper-2);
		text-decoration: none;
		color: var(--ink);
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}
	.rel-card:hover {
		box-shadow: 6px 6px 0 var(--pink);
		transform: translate(-2px, -2px);
	}
	.rel-thumb {
		display: block;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		border-bottom: 2px solid var(--ink);
	}
	.rel-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.4s ease;
	}
	.rel-card:hover .rel-thumb img {
		transform: scale(1.05);
	}
	.rel-body {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 0.8rem 0.9rem 1rem;
	}
	.rel-cat {
		font-family: var(--font-mono);
		font-size: 0.66rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--pink);
	}
	.rel-title {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: 1.08rem;
		line-height: 1.12;
	}
	.rel-date {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--muted);
	}

	/* Navegación anterior / siguiente */
	.art-nav {
		max-width: 60rem;
		margin: 2.5rem auto 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	.art-nav-link {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 0.9rem 1.1rem;
		border: 1px solid var(--line);
		text-decoration: none;
		color: var(--ink);
		transition: border-color 0.2s ease, background 0.2s ease;
	}
	.art-nav-link:hover {
		border-color: var(--ink);
		background: var(--paper-2);
	}
	.art-nav-link.next {
		text-align: right;
	}
	.art-nav-dir {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--pink);
	}
	.art-nav-title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.02rem;
		line-height: 1.15;
	}
	.art-nav-empty {
		display: block;
	}

	@media (max-width: 640px) {
		.art-related-grid {
			grid-template-columns: 1fr;
		}
		.art-nav {
			grid-template-columns: 1fr;
		}
		.art-nav-link.next {
			text-align: left;
		}
		.art-nav-empty {
			display: none;
		}
	}

	/* Etiquetas */
	.art-tags {
		max-width: 40rem;
		margin: 2.5rem auto 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem 0.8rem;
	}
	.art-tags-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--pink);
	}
	.art-tags-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.tag-chip {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--ink);
		background: var(--paper-2);
		border: 1px solid var(--line);
		padding: 0.25rem 0.6rem;
		text-decoration: none;
		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease;
	}
	.tag-chip:hover {
		background: var(--pink);
		border-color: var(--ink);
		color: var(--ink);
	}

	/* Compartir */
	.art-share {
		max-width: 40rem;
		margin: 2.5rem auto 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.7rem 1rem;
		border-top: 2px solid var(--ink);
		padding-top: 1.1rem;
	}
	.art-share-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--pink);
	}
	.art-share-btns {
