---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'posts'>['data'];

const DEFAULT_COVER = '/default-cover.svg';
const { title, date, author, category, heroImage, imagePosition = 'center', citations } = Astro.props;

// Obras citadas: una entrada por línea.
const citationLines = (citations || '')
	.split(/\r?\n+/)
	.map((s) => s.trim())
	.filter(Boolean);

// Bio del autor: se toma de la colección "authors" y se muestra al final del texto.
const authorsList = await getCollection('authors');
const authorEntry = author
	? authorsList.find((a) => a.data.name.trim() === author.trim())
	: undefined;
const AuthorBio =
	authorEntry && authorEntry.body && authorEntry.body.trim()
		? (await render(authorEntry)).Content
		: null;
---

<html lang="es">
	<head>
		<BaseHead title={title} description={category ? `${category} — ${title}` : title} />
	</head>
	<body>
		<Header />
		<main class="article at-container">
			<a class="back" href="/">← índice</a>

			<header class="art-head">
				{category && <span class="at-tag">{category}</span>}
				<h1 class="art-title">{title}</h1>
				<p class="art-meta">
					{author && <b>{author}</b>}
					{author && ' — '}
					<FormattedDate date={date} />
				</p>
			</header>

			<div class="art-hero">
				<img
					class="at-duotone"
					src={heroImage || DEFAULT_COVER}
					alt={title}
					style={`object-position: ${imagePosition};`}
				/>
			</div>

			<article class="prose">
				<slot />
			</article>

			{
				citationLines.length > 0 && (
					<section class="art-cites">
						<p class="art-cites-label">// obras citadas</p>
						<ul class="art-cites-list">
							{citationLines.map((c) => (
								<li class="art-cites-item">{c}</li>
							))}
						</ul>
					</section>
				)
			}

			{
				AuthorBio && (
					<aside class="art-author">
						<p class="art-author-label">// sobre el autor</p>
						{author && <p class="art-author-name">{author}</p>}
						<div class="art-author-bio">
							<AuthorBio />
						</div>
					</aside>
				)
			}

			<p class="art-end">// fin del texto</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article {
		padding-top: 1.5rem;
		padding-bottom: 2rem;
	}
	.back {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted);
		text-decoration: none;
	}
	.back:hover {
		color: var(--pink);
	}
	.art-head {
		max-width: 46rem;
		margin: 1.5rem auto 0;
		text-align: center;
	}
	.art-title {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: clamp(2.2rem, 6vw, 4rem);
		line-height: 1.03;
		margin: 0.8rem 0 0.8rem;
	}
	.art-meta {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--muted);
		margin: 0;
	}
	.art-meta b {
		color: var(--ink);
	}
	.art-hero {
		max-width: 60rem;
		margin: 2rem auto 0;
	}
	.art-hero img {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		object-position: center;
		border: 2px solid var(--ink);
	}
	.prose {
		max-width: 40rem;
		margin: 2.5rem auto 0;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 1.18rem;
		line-height: 1.75;
		color: #241d15;
	}
	.prose :global(p) {
		margin: 0 0 1.3rem;
	}
	.prose :global(a) {
		color: var(--pink);
	}
	.prose :global(em) {
		font-style: italic;
	}
	.prose :global(h2),
	.prose :global(h3) {
		font-weight: 900;
		line-height: 1.15;
		margin: 2rem 0 0.8rem;
	}
	.prose :global(blockquote) {
		border-left: 3px solid var(--pink);
		margin: 1.5rem 0;
		padding-left: 1.2rem;
		font-style: italic;
		color: #3c3428;
	}
	/* Imágenes dentro del cuerpo (entre párrafos) */
	.prose :global(img) {
		display: block;
		width: 100%;
		height: auto;
		margin: 1.8rem 0;
		border: 2px solid var(--ink);
	}
	.prose :global(figure) {
		margin: 1.8rem 0;
	}
	.prose :global(figcaption) {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--muted);
		margin-top: 0.4rem;
		text-align: center;
	}

	/* Obras citadas — bloque distinto, on-brand, con sangría francesa */
	.art-cites {
		max-width: 40rem;
		margin: 3rem auto 0;
		padding: 1.2rem 1.5rem 1.4rem;
		border: 1px solid var(--ink);
		background: var(--paper-2);
	}
	.art-cites-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--pink);
		margin: 0 0 0.8rem;
	}
	.art-cites-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.art-cites-item {
		font-family: var(--font-display);
		font-size: 0.95rem;
		line-height: 1.5;
		color: #3c3428;
		padding-left: 1.5rem;
		text-indent: -1.5rem;
		margin: 0 0 0.6rem;
	}
	.art-cites-item:last-child {
		margin-bottom: 0;
	}

	/* Sobre el autor — panel oscuro (modo terminal) que sobresale del cuerpo */
	.art-author {
		max-width: 40rem;
		margin: 3rem auto 0;
		padding: 1.6rem 1.6rem 1.5rem;
		border: 2px solid var(--ink);
		background: var(--negro);
		color: var(--crema);
		box-shadow: 8px 8px 0 var(--pink);
	}
	.art-author-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--pink);
		margin: 0 0 0.5rem;
	}
	.art-author-name {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: 1.35rem;
		margin: 0 0 0.5rem;
		color: var(--crema);
	}
	.art-author-bio {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 1.02rem;
		line-height: 1.6;
		color: #d8ccb6;
	}
	.art-author-bio :global(p) {
		margin: 0 0 0.7rem;
	}
	.art-author-bio :global(p:last-child) {
		margin-bottom: 0;
	}
	.art-author-bio :global(a) {
		color: var(--pink);
	}
	.art-end {
		max-width: 40rem;
		margin: 2.5rem auto 0;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--muted);
	}
</style>
