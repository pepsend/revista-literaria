---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import { categorySlug } from '../content.config';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Comments from '../components/Comments.astro';

type CardData = {
	slug: string;
	title: string;
	category: string | null;
	date: Date;
	heroImage: string | null;
	imagePosition: string;
};
type Props = CollectionEntry<'posts'>['data'] & {
	newer?: CardData | null;
	older?: CardData | null;
	related?: (CardData | null)[];
	readingMinutes?: number;
	headings?: { depth: number; slug: string; text: string }[];
};

const DEFAULT_COVER = '/default-cover.svg';
const {
	title,
	date,
	author,
	category,
	heroImage,
	imagePosition = 'center',
	authorBio,
	citations,
	justify = true,
	tags = [],
	newer = null,
	older = null,
	related = [],
	readingMinutes,
	headings = [],
} = Astro.props;

// Relacionados válidos (descarta posibles nulos por seguridad).
const relatedCards = (related || []).filter(Boolean) as CardData[];

// Etiquetas limpias: sin vacías ni espacios sobrantes (evita enlaces rotos).
const cleanTags = (tags || []).map((t) => (t || '').trim()).filter(Boolean);

// Índice de contenidos: subtítulos h2/h3. Solo se muestra en textos estructurados.
const toc = (headings || []).filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.length >= 3;

// URL canónica del texto para los botones de compartir.
const shareUrl = new URL(Astro.url.pathname, Astro.site).href;
const waHref = `https://wa.me/?text=${encodeURIComponent(`${title} — ${shareUrl}`)}`;
const xHref = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(shareUrl)}`;

// Imagen absoluta para OG / datos estructurados.
const ogAbs = heroImage
	? heroImage.startsWith('http')
		? heroImage
		: new URL(heroImage, Astro.site).href
	: undefined;

// Tarjeta OG: dibuja el título sobre la foto (solo si el hero está en Cloudinary).
// Para textos futuros funciona automáticamente; si el hero no es de Cloudinary,
// se usa la imagen tal cual (fallback).
// Codifica texto para Cloudinary: doble-codifica coma y barra (son separadores de
// sus transformaciones). Sin esto, cualquier frase/título con comas rompe la tarjeta.
const cldText = (s: string): string =>
	encodeURIComponent(s).replace(/%2C/g, '%252C').replace(/%2F/g, '%252F');

const buildOgCard = (url: string, t: string): string => {
	const txt = cldText(t);
	const overlay = `w_1200,h_630,c_fill,g_auto,f_jpg,q_auto:good/e_brightness:-30/co_rgb:f2e4cc,l_text:Georgia_64_bold:${txt},g_south_west,x_72,y_94,w_1056,c_fit`;
	const marker = '/image/upload/';
	const idx = url.indexOf(marker);
	// Caso 1: la imagen ya está en Cloudinary → transformación nativa.
	if (idx !== -1 && url.includes('res.cloudinary.com')) {
		return `${url.slice(0, idx + marker.length)}${overlay}/${url.slice(idx + marker.length)}`;
	}
	// Caso 2: cualquier otra imagen (ej. /uploads o URL externa) → Cloudinary "fetch",
	// que trae la imagen remota y le dibuja el título igual. Así TODOS los textos
	// (nuevos y antiguos) tienen su tarjeta, sin re-subir nada.
	const abs = url.startsWith('http') ? url : new URL(url, Astro.site).href;
	return `https://res.cloudinary.com/cs8tnt88/image/fetch/${overlay}/${abs}`;
};
const ogCard = heroImage ? buildOgCard(heroImage, title) : null;

// Tarjeta vertical 9:16 para Instagram Stories (imagen + marca + título + URL).
const buildStoryCard = (url: string, t: string, meta: string): string => {
	const enc = cldText(t);
	// Línea discreta con género · autor (solo si hay algo). Va encima de la URL.
	const metaLayer = meta
		? 'co_rgb:f2e4cc,l_text:Georgia_40_bold:' + cldText(meta) + '/g_south,y_220,fl_layer_apply/'
		: '';
	const layers =
		'co_rgb:e5468a,l_text:Georgia_46_bold:abulia%20terminal/g_north,y_180,fl_layer_apply/' +
		// Ancho junto al texto → el título largo envuelve en varias líneas (no se encoge).
		'w_880,c_fit,co_rgb:f2e4cc,l_text:Georgia_84_bold:' +
		enc +
		'/g_center,fl_layer_apply/' +
		metaLayer +
		'co_rgb:cbb89f,l_text:Georgia_28_bold:abuliaterminal.cl/g_south,y_150,fl_layer_apply';
	const overlay = 'w_1080,h_1920,c_fill,g_auto,f_jpg,q_auto:good/e_brightness:-34/' + layers;
	const marker = '/image/upload/';
	const idx = url.indexOf(marker);
	if (idx !== -1 && url.includes('res.cloudinary.com')) {
		return `${url.slice(0, idx + marker.length)}${overlay}/${url.slice(idx + marker.length)}`;
	}
	const abs = url.startsWith('http') ? url : new URL(url, Astro.site).href;
	return `https://res.cloudinary.com/cs8tnt88/image/fetch/${overlay}/${abs}`;
};
// Género · autor REALES de este texto (los que no existan, se omiten).
const storyMeta = [category, author].filter(Boolean).join(' · ');
const storyCard = heroImage ? buildStoryCard(heroImage, title, storyMeta) : null;

// Plantilla para "compartir una frase": el lector marca texto y se inserta en __Q__.
const buildQuoteTemplate = (url: string, attribution: string): string => {
	const attr = attribution ? cldText(attribution) : '';
	const attrLayer = attr
		? 'co_rgb:cbb89f,l_text:Georgia_34_bold:' + attr + '/g_south,y_140,fl_layer_apply/'
		: '';
	const layers =
		'co_rgb:e5468a,l_text:Georgia_40_bold:abulia%20terminal/g_north,y_120,fl_layer_apply/' +
		'w_900,c_fit,co_rgb:f2e4cc,l_text:Georgia_60_italic:__Q__/g_center,fl_layer_apply/' +
		attrLayer;
	const overlay = 'w_1080,h_1350,c_fill,g_auto,f_jpg,q_auto:good/e_brightness:-48/' + layers;
	const marker = '/image/upload/';
	const idx = url.indexOf(marker);
	if (idx !== -1 && url.includes('res.cloudinary.com')) {
		return `${url.slice(0, idx + marker.length)}${overlay}/${url.slice(idx + marker.length)}`;
	}
	const abs = url.startsWith('http') ? url : new URL(url, Astro.site).href;
	return `https://res.cloudinary.com/cs8tnt88/image/fetch/${overlay}/${abs}`;
};
const quoteTemplate = heroImage
	? buildQuoteTemplate(heroImage, author ? `— ${author}` : 'abulia terminal')
	: null;

// Datos estructurados (schema.org Article) para buscadores y redes.
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	datePublished: date.toISOString(),
	dateModified: date.toISOString(),
	inLanguage: 'es',
	mainEntityOfPage: { '@type': 'WebPage', '@id': shareUrl },
	publisher: { '@type': 'Organization', name: 'abulia terminal' },
	...(author ? { author: { '@type': 'Person', name: author } } : {}),
	...(ogAbs ? { image: [ogAbs] } : {}),
	...(category ? { articleSection: category } : {}),
};

// Bio del autor escrita en este artículo (una o más líneas → párrafos).
const postBioLines = (authorBio || '')
	.split(/\r?\n+/)
	.map((s) => s.trim())
	.filter(Boolean);

// Obras citadas: una entrada por línea.
const citationLines = (citations || '')
	.split(/\r?\n+/)
	.map((s) => s.trim())
	.filter(Boolean);

// Bio del autor: se toma de la colección "authors" y se muestra al final del texto.
const authorsList = await getCollection('authors');
const authorEntry = author
	? authorsList.find((a) => a.data.name.trim() === author.trim())
	: undefined;
const AuthorBio =
	authorEntry && authorEntry.body && authorEntry.body.trim()
		? (await render(authorEntry)).Content
		: null;
---

<html lang="es">
	<head>
		<BaseHead
			title={title}
			description={category ? `${category} — ${title}` : title}
			ogImage={ogCard ?? heroImage}
			type="article"
			publishedTime={date.toISOString()}
			authorName={author}
			section={category}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	</head>
	<body>
		<div class="read-progress" aria-hidden="true"><span id="read-progress-fill"></span></div>
		<Header />
		<main class="article at-container">
			<a class="back" href="/">← índice</a>

			<header class="art-head">
				{category && <span class="at-tag">{category}</span>}
				<h1 class="art-title">{title}</h1>
				<p class="art-meta">
					{author && (
						<a class="meta-author" href={`/autores/${categorySlug(author)}/`}>
							{author}
						</a>
					)}
					{author && ' — '}
					<FormattedDate date={date} />
					{readingMinutes && <span class="art-rt"> · {readingMinutes} min de lectura</span>}
				</p>
			</header>

			<div class="art-hero">
				<img
					class="at-duotone"
					src={heroImage || DEFAULT_COVER}
					alt={title}
					width="1600"
					height="900"
					style={`object-position: ${imagePosition};`}
				/>
			</div>

			<div class="art-share art-share--top">
				<span class="art-share-label">// compartir</span>
				<div class="art-share-btns">
					<a class="share-btn" href={waHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
					<a class="share-btn" href={xHref} target="_blank" rel="noopener noreferrer">X</a>
					{storyCard && (
						<button
							class="share-btn"
							type="button"
							id="share-story"
							data-story={storyCard}
							data-url={shareUrl}
						>
							Instagram
						</button>
					)}
					<button class="share-btn" type="button" id="copy-link" data-url={shareUrl}>
						copiar enlace
					</button>
				</div>
			</div>

			<div class="reading-size" role="group" aria-label="Tamaño del texto">
				<span class="rs-label">// tamaño</span>
				<button id="rs-dec" class="rs-btn" type="button" aria-label="Achicar texto">A−</button>
				<button id="rs-inc" class="rs-btn" type="button" aria-label="Agrandar texto">A+</button>
			</div>

			{
				showToc && (
					<nav class="art-toc" aria-label="Índice del texto">
						<p class="art-toc-label">// índice</p>
						<ol class="art-toc-list">
							{toc.map((h) => (
								<li class:list={['toc-item', { 'toc-sub': h.depth === 3 }]}>
									<a href={`#${h.slug}`}>{h.text}</a>
								</li>
							))}
						</ol>
					</nav>
				)
			}

			<article class:list={['prose', { 'prose--justify': justify }]}>
				<slot />
			</article>

			{
				cleanTags.length > 0 && (
					<section class="art-tags">
						<span class="art-tags-label">// etiquetas</span>
						<span class="art-tags-list">
							{cleanTags.map((t) => (
								<a class="tag-chip" href={`/tags/${categorySlug(t)}/`}>
									#{t}
								</a>
							))}
						</span>
					</section>
				)
			}

			{
				(postBioLines.length > 0 || AuthorBio) && (
					<aside class="art-author">
						<p class="art-author-label">// sobre el autor</p>
						{author && (
							<p class="art-author-name">
								<a href={`/autores/${categorySlug(author)}/`}>{author}</a>
							</p>
						)}
						<div class="art-author-bio">
							{postBioLines.length > 0 ? postBioLines.map((p) => <p>{p}</p>) : <AuthorBio />}
						</div>
					</aside>
				)
			}

			{
				citationLines.length > 0 && (
					<section class="art-cites">
						<p class="art-cites-label">// obras citadas</p>
						<ul class="art-cites-list">
							{citationLines.map((c) => (
								<li class="art-cites-item">{c}</li>
							))}
						</ul>
					</section>
				)
			}

			<p class="art-end">// fin del texto</p>

			<Comments pageId={Astro.url.pathname} />

			{
				relatedCards.length > 0 && (
					<section class="art-related">
						<p class="art-related-label">// seguir leyendo</p>
						<div class="art-related-grid">
							{relatedCards.map((r) => (
								<a class="rel-card" href={`/blog/${r.slug}/`}>
									<span class="rel-thumb">
										<img
											class="at-duotone"
											src={r.heroImage || DEFAULT_COVER}
											alt={r.title}
											loading="lazy"
											width="300"
											height="200"
											style={`object-position: ${r.imagePosition};`}
										/>
									</span>
									<span class="rel-body">
										{r.category && <span class="rel-cat">{r.category}</span>}
										<span class="rel-title">{r.title}</span>
										<span class="rel-date">
											<FormattedDate date={r.date} />
										</span>
									</span>
								</a>
							))}
						</div>
					</section>
				)
			}

			{
				(older || newer) && (
					<nav class="art-nav" aria-label="Navegación entre textos">
						{older ? (
							<a class="art-nav-link prev" href={`/blog/${older.slug}/`}>
								<span class="art-nav-dir">← más antigua</span>
								<span class="art-nav-title">{older.title}</span>
							</a>
						) : (
							<span class="art-nav-empty" />
						)}
						{newer ? (
							<a class="art-nav-link next" href={`/blog/${newer.slug}/`}>
								<span class="art-nav-dir">más reciente →</span>
								<span class="art-nav-title">{newer.title}</span>
							</a>
						) : (
							<span class="art-nav-empty" />
						)}
					</nav>
				)
			}
		</main>
		<button id="to-top" class="to-top" type="button" aria-label="Volver arriba">↑</button>
		{
			quoteTemplate && (
				<button
					id="quote-share"
					class="quote-share"
					type="button"
					hidden
					data-tpl={quoteTemplate}
					data-url={shareUrl}
				>
					❝ compartir frase
				</button>
			)
		}
		<Footer />
		<script is:inline>
			(function () {
				// Copiar enlace del texto
				var copyBtn = document.getElementById('copy-link');
				if (copyBtn) {
					copyBtn.addEventListener('click', function () {
						var url = copyBtn.getAttribute('data-url') || location.href;
						var done = function () {
							copyBtn.textContent = '¡copiado!';
							setTimeout(function () {
								copyBtn.textContent = 'copiar enlace';
							}, 1600);
						};
						if (navigator.clipboard && navigator.clipboard.writeText) {
							navigator.clipboard.writeText(url).then(done).catch(done);
						} else {
							var ta = document.createElement('textarea');
							ta.value = url;
							document.body.appendChild(ta);
							ta.select();
							try {
								document.execCommand('copy');
							} catch (e) {}
							document.body.removeChild(ta);
							done();
						}
					});
				}
				// Compartir a Instagram (celular): imagen 9:16. Se pre-descarga en segundo
				// plano para que al tocar el botón el compartir sea SÍNCRONO (iOS pierde el
				// permiso del gesto si hay un fetch en medio).
				var storyBtn = document.getElementById('share-story');
				if (storyBtn) {
					var storyImg = storyBtn.getAttribute('data-story');
					var storyFile = null;
					if (storyImg) {
						fetch(storyImg)
							.then(function (r) {
								return r.blob();
							})
							.then(function (b) {
								storyFile = new File([b], 'abulia-terminal.jpg', {
									type: b.type || 'image/jpeg',
								});
							})
							.catch(function () {});
					}
					storyBtn.addEventListener('click', function () {
						if (storyFile && navigator.canShare && navigator.canShare({ files: [storyFile] })) {
							navigator.share({ files: [storyFile] }).catch(function () {});
							try {
								if (navigator.clipboard) navigator.clipboard.writeText(storyBtn.getAttribute('data-url') || '');
							} catch (e) {}
							return;
						}
						try {
							if (navigator.clipboard) navigator.clipboard.writeText(storyBtn.getAttribute('data-url') || '');
						} catch (e) {}
						if (storyImg) window.open(storyImg, '_blank');
					});
				}
				// Volver arriba
				var toTop = document.getElementById('to-top');
				if (toTop) {
					var onScroll = function () {
						if (window.scrollY > 600) toTop.classList.add('show');
						else toTop.classList.remove('show');
					};
					window.addEventListener('scroll', onScroll, { passive: true });
					onScroll();
					toTop.addEventListener('click', function () {
						window.scrollTo({ top: 0, behavior: 'smooth' });
					});
				}
				// Barra de progreso de lectura
				var pf = document.getElementById('read-progress-fill');
				if (pf) {
					var updP = function () {
						var h = document.documentElement;
						var max = h.scrollHeight - h.clientHeight;
						var p = max > 0 ? (h.scrollTop / max) * 100 : 0;
						pf.style.width = p + '%';
					};
					window.addEventListener('scroll', updP, { passive: true });
					window.addEventListener('resize', updP, { passive: true });
					updP();
				}
				// Control de tamaño de letra (persistente entre artículos)
				var RS_KEY = 'at-reading-scale';
				var rsDec = document.getElementById('rs-dec');
				var rsInc = document.getElementById('rs-inc');
				var rsClamp = function (s) { return Math.min(1.6, Math.max(0.85, s)); };
				var rsGet = function () {
					var v = parseFloat(localStorage.getItem(RS_KEY));
					return isNaN(v) ? 1 : rsClamp(v);
				};
				var rsApply = function (s) {
					document.documentElement.style.setProperty('--reading-scale', String(s));
				};
				rsApply(rsGet());
				var rsSet = function (delta) {
					var s = rsClamp(Math.round((rsGet() + delta) * 100) / 100);
					rsApply(s);
					try { localStorage.setItem(RS_KEY, String(s)); } catch (e) {}
				};
				if (rsDec) rsDec.addEventListener('click', function () { rsSet(-0.1); });
				if (rsInc) rsInc.addEventListener('click', function () { rsSet(0.1); });
			})();
		</script>

		<script is:inline>
			(function () {
				var btn = document.getElementById('quote-share');
				var prose = document.querySelector('.prose');
				if (!btn || !prose) return;
				var tpl = btn.getAttribute('data-tpl');
				var pageUrl = btn.getAttribute('data-url') || '';
				var current = '';
				var readyText = '';
				var readyFile = null;

				function cldEnc(t) {
					return encodeURIComponent(t).replace(/%2C/g, '%252C').replace(/%2F/g, '%252F');
				}
				function imgFor(t) {
					return tpl.replace('__Q__', cldEnc(t));
				}
				function prefetch(t) {
					if (t === readyText) return;
					readyText = t;
					readyFile = null;
					fetch(imgFor(t))
						.then(function (r) {
							return r.blob();
						})
						.then(function (b) {
							if (readyText === t)
								readyFile = new File([b], 'cita-abulia-terminal.jpg', { type: b.type || 'image/jpeg' });
						})
						.catch(function () {});
				}

				function selectedText() {
					var s = window.getSelection();
					if (!s || s.rangeCount === 0 || s.isCollapsed) return '';
					var node = s.anchorNode;
					if (!node || !prose.contains(node)) return '';
					return s.toString().replace(/\s+/g, ' ').trim();
				}
				function hide() {
					btn.hidden = true;
				}
				function show() {
					var t = selectedText();
					if (t.length < 8) {
						hide();
						return;
					}
					if (t.length > 240) t = t.slice(0, 238).trim() + '…';
					current = t;
					btn.hidden = false;
					var rect = window.getSelection().getRangeAt(0).getBoundingClientRect();
					var top = window.scrollY + rect.top - btn.offsetHeight - 10;
					var left = window.scrollX + rect.left + rect.width / 2 - btn.offsetWidth / 2;
					var maxLeft = window.scrollX + document.documentElement.clientWidth - btn.offsetWidth - 8;
					left = Math.max(window.scrollX + 8, Math.min(left, maxLeft));
					if (top < window.scrollY + 6) top = window.scrollY + rect.bottom + 10;
					btn.style.top = top + 'px';
					btn.style.left = left + 'px';
					prefetch(current);
				}
				document.addEventListener('mouseup', function () {
					setTimeout(show, 10);
				});
				document.addEventListener('touchend', function () {
					setTimeout(show, 10);
				});
				window.addEventListener('scroll', hide, { passive: true });
				btn.addEventListener('mousedown', function (e) {
					e.preventDefault();
				});
				btn.addEventListener('click', function () {
					var t = current;
					if (!t) {
						hide();
						return;
					}
					// Si la imagen ya está lista → compartir SÍNCRONO (preserva el gesto en iOS).
					if (
						readyFile &&
						readyText === t &&
						navigator.canShare &&
						navigator.canShare({ files: [readyFile] })
					) {
						navigator.share({ files: [readyFile] }).catch(function () {});
						try {
							if (navigator.clipboard) navigator.clipboard.writeText(pageUrl);
						} catch (e) {}
						hide();
						return;
					}
					// Si aún no está lista → abrir la imagen para guardarla y publicarla.
					try {
						if (navigator.clipboard) navigator.clipboard.writeText(pageUrl);
					} catch (e) {}
					window.open(imgFor(t), '_blank');
					hide();
				});
			})();
		</script>
	</body>
</html>

<style>
	.article {
		padding-top: 1.5rem;
		padding-bottom: 2rem;
	}

	/* Barra de progreso de lectura */
	.read-progress {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		z-index: 200;
		background: transparent;
		pointer-events: none;
	}
	#read-progress-fill {
		display: block;
		height: 100%;
		width: 0;
