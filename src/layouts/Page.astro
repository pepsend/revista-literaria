---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description?: string;
	kicker?: string;
}

const { title, description, kicker } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`${title} · ${SITE_TITLE}`} description={description ?? title} />
	</head>
	<body>
		<Header />
		<main class="page at-container">
			{kicker && <p class="at-kicker">{kicker}</p>}
			<h1 class="page-title">{title}</h1>
			<hr class="at-rule page-rule" />
			<div class="prose">
				<slot />
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page {
		padding: 2.5rem 1.5rem 3rem;
		max-width: 48rem;
	}
	.page-title {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: clamp(2.4rem, 7vw, 4rem);
		line-height: 1;
		margin: 0.5rem 0 1.2rem;
		text-transform: lowercase;
	}
	.page-rule {
		margin-bottom: 2rem;
	}
	.prose {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 1.15rem;
		line-height: 1.75;
		color: var(--text);
	}
	.prose :global(p) {
		margin: 0 0 1.3rem;
	}
	.prose :global(strong) {
		font-weight: 900;
	}
	.prose :global(em) {
		font-style: italic;
	}
	.prose :global(a) {
		color: var(--pink);
	}
	.prose :global(h2) {
		font-weight: 900;
		font-size: 1.6rem;
		margin: 2rem 0 0.8rem;
	}
</style>
